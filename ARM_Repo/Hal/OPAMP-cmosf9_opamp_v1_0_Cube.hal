# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=OPAMP
Version=cmosf9_opamp_v1_0_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
NonInvertingInput|Non Inverting Input|Basic Parameters||||
InvertingInput|Inverting Input|Basic Parameters||||
PowerMode|Power Mode|Basic Parameters||||
PowerSupplyRange|Power Supply Range|Basic Parameters||||
UserTrimming|User Trimming|Basic Parameters||||Self Calibration is not available for LL configuration.
SelfCalibration|Self Calibration|Basic Parameters||||
TrimmingValueP|OffSet Trimming Value (PMOS)|Basic Parameters||0|30|
TrimmingValueN|OffSet Trimming Value (NMOS)|Basic Parameters||0|30|
TrimmingValuePLowPower|OffSet Trimming Value Low Power (PMOS)|Basic Parameters||0|30|
TrimmingValueNLowPower|OffSet Trimming Value Low Power (NMOS)|Basic Parameters||0|30|
Mode|Mode|Basic Parameters||||

[Values]
# параметр|значение|подпись
NonInvertingInput|OPAMP_NONINVERTINGINPUT_DAC_CH1|OPAMP Non Inverting Channel 1
NonInvertingInput|OPAMP_NONINVERTINGINPUT_DAC_CH2|OPAMP Non Inverting Channel 2
NonInvertingInput|OPAMP_NONINVERTINGINPUT_IO0|OPAMP Non Inverting Input VP0
InvertingInput|OPAMP_INVERTINGINPUT_IO0|OPAMP Inverting Input VM0
InvertingInput|OPAMP_INVERTINGINPUT_IO1|OPAMP Inverting Input VM1
PowerMode|OPAMP_POWERMODE_NORMAL|Normal
PowerMode|OPAMP_POWERMODE_LOWPOWER|Low Power
PowerSupplyRange|OPAMP_POWERSUPPLY_LOW|Power Supply Range Low
PowerSupplyRange|OPAMP_POWERSUPPLY_HIGH|Power Supply Range High
UserTrimming|OPAMP_TRIMMING_USER|Enable
UserTrimming|OPAMP_TRIMMING_FACTORY|Disable
Mode|OPAMP_STANDALONE_MODE|Standalone
Mode|OPAMP_FOLLOWER_MODE|Follower
