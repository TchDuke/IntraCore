# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=DAC
Version=WL_dacif_v3_0_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
DAC_Channel|Channel|||||
DAC_Trigger|Trigger|||||Specifies the external trigger for the selected DAC channel.
DAC_OutputBuffer|Output Buffer|||||
TriangleAmplitude|Triangle Amplitude|||||
NoiseAmplitude|Noise Amplitude|||||
WaveGeneration|Wave generation mode|||||
DAC_ConnectOnChipPeripheral1|Connect On Chip Peripheral1|||||Specifies whether the DAC output is connected or not to on chip peripheral .
DAC_ConnectOnChipPeripheral2|Connect On Chip Peripheral2|||||Specifies whether the DAC output is connected or not to on chip peripheral .
DAC_UserTrimming|User Trimming|||||Specifies the trimming mode This parameter must be a value of DAC User Trimming DAC_UserTrimming is either factory or user trimming
DAC_TrimmingValue|Trimming Value|||1|31|Specifies the offset trimming value i.
DAC_SampleAndHold|Mode selected|||||Specifies the DAC mode. In case of Sample and Hold Mode then specifies values in additionnal parameters : - Sample Time - Hold Time - Refresh Time
DAC_SampleTime|Sample Time|||0|1023|Specifies the Sample time for the selected channel.
DAC_HoldTime|Hold Time|||0|1023|Specifies the hold time for the selected channel This parameter applies when DAC_SampleAndHold is DAC_SAMPLEANDHOLD_ENABLE.
DAC_RefreshTime|Refresh Time|||0|255|Specifies the refresh time for the selected channel This parameter applies when DAC_SampleAndHold is DAC_SAMPLEANDHOLD_ENABLE.

[Values]
# параметр|значение|подпись
DAC_Channel|DAC_CHANNEL_1|DAC_CHANNEL_1
DAC_Trigger|DAC_TRIGGER_NONE|None
DAC_Trigger|DAC_TRIGGER_SOFTWARE|Software trigger
DAC_Trigger|DAC_TRIGGER_T1_TRGO|Timer 1 Trigger Out event
DAC_Trigger|DAC_TRIGGER_T2_TRGO|Timer 2 Trigger Out event
DAC_Trigger|DAC_TRIGGER_T4_TRGO|Timer 4 Trigger Out event
DAC_Trigger|DAC_TRIGGER_T5_TRGO|Timer 5 Trigger Out event
DAC_Trigger|DAC_TRIGGER_T6_TRGO|Timer 6 Trigger Out event
DAC_Trigger|DAC_TRIGGER_T7_TRGO|Timer 7 Trigger Out event
DAC_Trigger|DAC_TRIGGER_T8_TRGO|Timer 8 Trigger Out event
DAC_Trigger|DAC_TRIGGER_T15_TRGO|Timer 15 Trigger Out event
DAC_Trigger|DAC_TRIGGER_HR1_TRGO1|HR Timer 1 Trigger Out1 event
DAC_Trigger|DAC_TRIGGER_HR1_TRGO2|HR Timer 1 Trigger Out2 event
DAC_Trigger|DAC_TRIGGER_LPTIM1_OUT|LP Timer 1 Out event
DAC_Trigger|DAC_TRIGGER_LPTIM2_OUT|LP Timer 2 Out event
DAC_Trigger|DAC_TRIGGER_LPTIM3_OUT|LP Timer 3 Out event
DAC_Trigger|DAC_TRIGGER_EXT_IT9|External line 9
DAC_OutputBuffer|DAC_OUTPUTBUFFER_ENABLE|Enable
DAC_OutputBuffer|DAC_OUTPUTBUFFER_DISABLE|Disable
TriangleAmplitude|DAC_TRIANGLEAMPLITUDE_1|1
