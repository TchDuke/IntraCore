# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=VREFBUF
Version=STM32WBA_vrefbuf_v1_0

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
HighImpedanceMode|High impedance mode|||||
VoltageScaling|Internal Voltage reference scale|||||
TrimmingMode|Trimming Mode|||||
TrimmingValue|Trimming Value|||0|63|

[Values]
# параметр|значение|подпись
HighImpedanceMode|SYSCFG_VREFBUF_HIGH_IMPEDANCE_ENABLE|Enable
HighImpedanceMode|SYSCFG_VREFBUF_HIGH_IMPEDANCE_DISABLE|Disable
VoltageScaling|SYSCFG_VREFBUF_VOLTAGE_SCALE0|SCALE 0: around 2.048 V
VoltageScaling|SYSCFG_VREFBUF_VOLTAGE_SCALE1|SCALE 1: around 2.5 V
VoltageScaling|SYSCFG_VREFBUF_VOLTAGE_SCALE2|SCALE 2: around 2.048 V
VoltageScaling|SYSCFG_VREFBUF_VOLTAGE_SCALE3|SCALE 3: around 2.5 V
TrimmingMode|__NULL|Factory Trimming
TrimmingMode|USER_TRIMMING|User Trimming
