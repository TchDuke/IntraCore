# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=AES
Version=aes1_v1_0_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
Data encryption types list|Data encryption type|Algorithm||||AES Data encryption types list
DataType|Data type|Parameters||||AES Data Type selection: 32-bit data, 16-bit data, 8-bit data or 1-bit string. This parameter can be a value of @ref CRYP_Data_Type. Possible values are: CRYP_DATATYPE_32B: 32-bit data type (no swapping) CRYP_DATATYPE_16B: 16-bit data type (half-word swapping) CRYP_DATATYPE_8B: 8-bit data type (byte swapping) CRYP_DATATYPE_1B: 1-bit data type (bit swapping)
pKey|Encryption/Decryption key|Parameters||||Encryption/Decryption key
pInitVect|Initialization vector|Parameters||||Initialization Vector in CBC mode, used also for 32-bit counter initialization in CTR mode

[Values]
# параметр|значение|подпись
DataType|CRYP_DATATYPE_32B|32b(no swapping)
DataType|CRYP_DATATYPE_16B|16b(half-word swapping)
DataType|CRYP_DATATYPE_8B|8b(byte swapping)
DataType|CRYP_DATATYPE_1B|1b(bit swapping)
