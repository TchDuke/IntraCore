# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=USB_OTG_FS
Version=otgfs1_v3_0_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
VirtualMode||Basic Parameters||||
dev_endpoints|Device endpoints number|||1|6|
Host_channels|Host Channels|||1|12|
speed|Speed|||||
DeviceSpeed|Speed|||||
dma_enable|Enable internal IP DMA|||||
ep0_mps|Endpoint 0 Max Packet size|||||
phy_itface|Physical interface|||||
Sof_enable|Signal start of frame|||||
lpm_enable|Link Power Management|||||
low_power_enable|Low power|||||
battery_charging_enable|Battery charging|||||
vbus_sensing_enable|VBUS sensing|||||
use_dedicated_ep1|Use dedicated end point 1 interrupt|||||
use_external_vbus|Use external vbus|||||

[Values]
# параметр|значение|подпись
VirtualMode|Host_Only|
VirtualMode|Device_Only|
speed|USB_OTG_SPEED_FULL|Full Speed 12MBit/s
speed|USB_OTG_SPEED_LOW|Low Speed 1.5MBit/s
DeviceSpeed|HCD_SPEED_FULL|Full Speed 12MBit/s
DeviceSpeed|HCD_SPEED_LOW|Low Speed 1.5MBit/s
DeviceSpeed|PCD_SPEED_FULL|Full Speed 12MBit/s
ep0_mps|DEP0CTL_MPS_64|64 Bytes
ep0_mps|DEP0CTL_MPS_32|32 Bytes
ep0_mps|DEP0CTL_MPS_16|16 Bytes
ep0_mps|DEP0CTL_MPS_8|8 Bytes
phy_itface|PCD_PHY_EMBEDDED|Internal Phy
