# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=ADC
Version=aditf3_v1_1_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
FadcConstraint|Fadc Constraint|||480000|4000000|
ClockPrescaler|Clock Prescaler|ADCgroup||||frequency of the clock to the ADC. The clock is common for all the ADCs.
ChannelsBank|Bank to use|ADCgroup||||Selected the channels bank used to select channel sources in Regular and Injected conversion.
Resolution|Resolution|ADCgroup||||Resolution of the ADC conversion
DataAlign|Data Alignment|ADCgroup||||Select the alignment of the data stored after conversion.
ScanConvMode|Scan Mode|ADCgroup||||Enable/Disable DMA Continuous Requests
ContinuousConvMode|Continuous Conversion Mode|ADCgroup||||Enable or Disable the Continuous Conversion Mode
DiscontinuousConvMode|Discontinuous Conversion Mode|||||Enable or Disable the Discontinuous Conversion Mode
NbrOfDiscConversion|Number Of Discontinuous Conversions|||1|8|
DMAContinuousRequests|DMA Continuous Requests|ADCgroup||||This parameter is used only when a DMA Request is configured. Else it is not relevant. When the DMA Request for this ADC instance this parameter specifies whether the DMA requests are performed in one shot mode (DMA transfer stops when number of conversions is reached) or are performed in continuous mode (DMA transfer unlimited, whatever number of conversions). Note: In continuous mode, DMA must be configured in circular mode. Otherwise an overrun will be triggered when DMA buffer maximum pointer is reached.
EOCSelection|End Of Conversion Selection|ADCgroup||||Regular channel end of conversion selection
Overrun|Overrun behaviour|ADCgroup||||Select the behaviour in case of overrun
LowPowerAutoWait|Low Power Auto Wait|||||Specifies the usage of dynamic low power Auto Delay: New conversion start only when the previous conversion (for regular group) or previous sequence (for injected group) has been treated by user software.
LowPowerAutoPowerOff|Low Power Auto Off|||||The ADC automatically powers-off after a conversion and automatically wakes-up when a new conversion is triggered
NbrOfConversionFlag|Number Of Conversion Flag|ADCgroup||0|1|
NbrOfConversion|Number Of Conversion|ADCgroup||1|27|Number of regular channels to be converted
ExternalTrigConv|External Trigger Conversion Source|ADCgroup||||Select the external event used to trigger the start of conversion of a regular group
ExternalTrigConvEdge|External Trigger Conversion Edge|ADCgroup||||Select the external trigger polarity and enable the trigger of a regular group.
Rank|Rank|ADCChannel||1|27|The rank in the regular group sequencer
Channel|Channel|ADCChannel||||
SamplingTime|Sampling Time|ADCChannel||||Regular Channel x sampling time selection
InjNumberOfConversion|Number Of Conversions|ADCgroup||0|4|Number of injected channels to be converted
ExternalTrigInjecConv|External Trigger Source|ADCgroup||||EXTI Line15 is used for External-Trigger-for-Injected-conversion mode
ExternalTrigInjecConvEdge|External Trigger Conversion Edge|ADCgroup||||You cannot configure a trigger because the Auto Injected mode is selected.
InjectedConvMode|Injected Conversion Mode|ADCgroup||||Injected Conversion Mode selection
InjectedDiscontinuousConvMode|Injected Discontinuous Conversion Mode|||||
AutoInjectedConv|Automatic Injected Conversion|||||
InjectedRank|Rank|ADCChannel||1|4|The rank in the regular group sequencer
InjectedChannel|Channel|ADCChannel||||
InjectedSamplingTime|Sampling Time|ADCChannel||||Regular Channel x sampling time selection
InjectedOffset|Injected Offset|ADCgroup||0|4095|Data offset for Injected channel
EnableAnalogWatchDog|Enable Analog WatchDog Mode|ADCgroup||||Enable/Disable Analog WatchDog Mode
WatchdogMode|Watchdog Mode|ADCgroup||||Configures the ADC analog watchdog mode.
WatchdogChannel|Analog WatchDog Channel|ADCChannel||||ADC channel for the analog watchdog
HighThreshold|High Threshold|ADCgroup||=AWD1LowThreshold|4095|Configures the ADC analog watchdog High threshold value.
LowThreshold|Low Threshold|ADCgroup||0|=AWD1HighThreshold|Configures the ADC analog watchdog Low threshold value.
ITMode|Interrupt Mode|ADCgroup||||Specifies whether the analog watchdog is configured in interrupt mode or in polling mode.
master|Master Flag|||0|1|
AllChannels|Channel|ADCChannel||||
AnalogWDChannel|Analog WatchDog Channel|ADCChannel||||
ChannelForWatchDog|Channel type for WatchDog|||||
RI_IOSWITCH_VCOMP_Parameter|defaul value of the macro|||||

[Values]
# параметр|значение|подпись
ClockPrescaler|ADC_CLOCK_ASYNC_DIV1|Asynchronous clock mode divided by 1
ClockPrescaler|ADC_CLOCK_ASYNC_DIV2|Asynchronous clock mode divided by 2
ClockPrescaler|ADC_CLOCK_ASYNC_DIV4|Asynchronous clock mode divided by 4
ChannelsBank|ADC_CHANNELS_BANK_A|Bank A
ChannelsBank|ADC_CHANNELS_BANK_B|Bank B
ChannelsBank|__NULL|none
Resolution|ADC_RESOLUTION_12B|ADC 12-bit resolution
Resolution|ADC_RESOLUTION_10B|ADC 10-bit resolution
Resolution|ADC_RESOLUTION_8B|ADC 8-bit resolution
Resolution|ADC_RESOLUTION_6B|ADC 6-bit resolution
DataAlign|ADC_DATAALIGN_RIGHT|Right alignment
DataAlign|ADC_DATAALIGN_LEFT|Left alignment
ScanConvMode|ADC_SCAN_DISABLE|Disabled
ScanConvMode|ADC_SCAN_ENABLE|Enabled
EOCSelection|ADC_EOC_SINGLE_CONV|End of single conversion
EOCSelection|ADC_EOC_SEQ_CONV|End of sequence conversion
EOCSelection|EOC_SINGLE_SEQ_CONV|End of single or sequence of conversion
Overrun|OVR_DATA_PRESERVED|Overrun data preserved
Overrun|OVR_DATA_OVERWRITTEN|Overrun data overwritten
LowPowerAutoWait|ADC_AUTOWAIT_DISABLE|Disabled
LowPowerAutoWait|ADC_AUTOWAIT_UNTIL_DATA_READ|Wait until the result of previous conversion is read
LowPowerAutoWait|ADC_AUTOWAIT_7_APBCLOCKCYCLES|Wait for 7 APB clock cycles
LowPowerAutoWait|ADC_AUTOWAIT_15_APBCLOCKCYCLES|Wait for 15 APB clock cycles
LowPowerAutoWait|ADC_AUTOWAIT_31_APBCLOCKCYCLES|Wait for 31 APB clock cycles
LowPowerAutoWait|ADC_AUTOWAIT_63_APBCLOCKCYCLES|Wait for 63 APB clock cycles
LowPowerAutoWait|ADC_AUTOWAIT_127_APBCLOCKCYCLES|Wait for 127 APB clock cycles
LowPowerAutoWait|ADC_AUTOWAIT_255_APBCLOCKCYCLES|Wait for 255 APB clock cycles
LowPowerAutoPowerOff|ADC_AUTOPOWEROFF_DISABLE|Disabled
LowPowerAutoPowerOff|ADC_AUTOPOWEROFF_IDLE_PHASE|power off when ADC is not converting
LowPowerAutoPowerOff|ADC_AUTOPOWEROFF_DELAY_PHASE|power off when a delay is inserted between conversions
LowPowerAutoPowerOff|ADC_AUTOPOWEROFF_IDLE_DELAY_PHASES|power off when ADC is not converting and when a delay is inserted between conversions
