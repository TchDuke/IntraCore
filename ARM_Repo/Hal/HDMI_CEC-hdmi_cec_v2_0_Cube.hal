# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=HDMI_CEC
Version=hdmi_cec_v2_0_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
Tolerance|Rx tolerance|Configuration parameters||||
ListenMode|Listening mode|Configuration parameters||||
SignalFreeTime|Signal Free Time|Configuration parameters||||In the first configuration (2.5, 4 or 6), the number of nominal data bit periods waited before transmission is ruled by hardware according to the transmission history. In all the other configurations, the Signal Free Time is determined by software.
SignalFreeTimeOption|Signal Free Time option|Configuration parameters||||
OwnAddress|CEC device address|Address parameters||0x0|0x7FFF|OAR: Own addresses configuration The OAR bits are set by software to select which destination logical addresses have to be considered in receive mode. Each bit, when set, enables the CEC logical address identified by the given bit position. At the end of HEADER reception, the received destination address is compared with the enabled addresses. In case of matching address, the incoming message is acknowledged and received. In case of non-matching address, the incoming message is received only in listen mode (LSTN=1), but without acknowledge sent. Broadcast messages are always received. Example: OAR = 0b000 0000 0010 0001 means that CEC acknowledges addresses 0x0 and 0x5. Consequently, each message directed to one of these addresses is received.
OwnAddress0|Logical address 0|Address parameters||||
OwnAddress1|Logical address 1|Address parameters||||
OwnAddress2|Logical address 2|Address parameters||||
OwnAddress3|Logical address 3|Address parameters||||
OwnAddress4|Logical address 4|Address parameters||||
OwnAddress5|Logical address 5|Address parameters||||
OwnAddress6|Logical address 6|Address parameters||||
OwnAddress7|Logical address 7|Address parameters||||
OwnAddress8|Logical address 8|Address parameters||||
OwnAddress9|Logical address 9|Address parameters||||
OwnAddress10|Logical address 10|Address parameters||||
OwnAddress11|Logical address 11|Address parameters||||
OwnAddress12|Logical address 12|Address parameters||||
OwnAddress13|Logical address 13|Address parameters||||
OwnAddress14|Logical address 14|Address parameters||||
InitiatorAddress|Initiator address|Address parameters||0|15|
BREErrorBitGen|Generate error bit on bit rising error|Error handling||||
LBPEErrorBitGen|Generate error bit on long bit period error|Error handling||||
BRERxStop|Stop reception on bit rising error|Error handling||||
BroadcastMsgNoErrorBitGen|Avoid error bit generation on error detection in broadcast|Error handling||||
RxBuffer|Received data buffer name|Address parameters||||

[Values]
# параметр|значение|подпись
Tolerance|CEC_STANDARD_TOLERANCE|Standard tolerance
Tolerance|CEC_EXTENDED_TOLERANCE|Extended tolerance
ListenMode|CEC_REDUCED_LISTENING_MODE|Receive messages addressed to its own address and broadcast messages
ListenMode|CEC_FULL_LISTENING_MODE|Receive all messages
SignalFreeTime|CEC_DEFAULT_SFT|2.5, 4 or 6 nominal data bit periods
SignalFreeTime|CEC_0_5_BITPERIOD_SFT|0.5 nominal data bit periods
SignalFreeTime|CEC_1_5_BITPERIOD_SFT|1.5 nominal data bit periods
SignalFreeTime|CEC_2_5_BITPERIOD_SFT|2.5 nominal data bit periods
SignalFreeTime|CEC_3_5_BITPERIOD_SFT|3.5 nominal data bit periods
SignalFreeTime|CEC_4_5_BITPERIOD_SFT|4.5 nominal data bit periods
SignalFreeTime|CEC_5_5_BITPERIOD_SFT|5.5 nominal data bit periods
SignalFreeTime|CEC_6_5_BITPERIOD_SFT|6.5 nominal data bit periods
SignalFreeTimeOption|CEC_SFT_START_ON_TXSOM|SFT timer starts when Transmission Start Of Message is set by software
SignalFreeTimeOption|CEC_SFT_START_ON_TX_RX_END|SFT timer starts automatically at the end of message transmission/reception
OwnAddress|CEC_OWN_ADDRESS_NONE|No logical address
OwnAddress0|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress0|CEC_OWN_ADDRESS_0|Enable
OwnAddress1|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress1|CEC_OWN_ADDRESS_1|Enable
OwnAddress2|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress2|CEC_OWN_ADDRESS_2|Enable
OwnAddress3|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress3|CEC_OWN_ADDRESS_3|Enable
OwnAddress4|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress4|CEC_OWN_ADDRESS_4|Enable
OwnAddress5|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress5|CEC_OWN_ADDRESS_5|Enable
OwnAddress6|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress6|CEC_OWN_ADDRESS_6|Enable
OwnAddress7|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress7|CEC_OWN_ADDRESS_7|Enable
OwnAddress8|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress8|CEC_OWN_ADDRESS_8|Enable
OwnAddress9|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress9|CEC_OWN_ADDRESS_9|Enable
OwnAddress10|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress10|CEC_OWN_ADDRESS_10|Enable
OwnAddress11|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress11|CEC_OWN_ADDRESS_11|Enable
OwnAddress12|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress12|CEC_OWN_ADDRESS_12|Enable
OwnAddress13|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress13|CEC_OWN_ADDRESS_13|Enable
OwnAddress14|CEC_OWN_ADDRESS_NONE|Disable
OwnAddress14|CEC_OWN_ADDRESS_14|Enable
BREErrorBitGen|CEC_BRE_ERRORBIT_NO_GENERATION|No error bit generation
BREErrorBitGen|CEC_BRE_ERRORBIT_GENERATION|Error bit generation
LBPEErrorBitGen|CEC_LBPE_ERRORBIT_NO_GENERATION|No error bit generation
LBPEErrorBitGen|CEC_LBPE_ERRORBIT_GENERATION|Error bit generation
BRERxStop|CEC_NO_RX_STOP_ON_BRE|Reception is not stopped
BRERxStop|CEC_RX_STOP_ON_BRE|Reception is stopped
BroadcastMsgNoErrorBitGen|CEC_BROADCASTERROR_NO_ERRORBIT_GENERATION|No error bit generation
BroadcastMsgNoErrorBitGen|CEC_BROADCASTERROR_ERRORBIT_GENERATION|Error bit generation
