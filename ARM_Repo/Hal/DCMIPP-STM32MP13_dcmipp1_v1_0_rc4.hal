# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=DCMIPP
Version=STM32MP13_dcmipp1_v1_0_rc4

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
ExtendedDataMode|Extended Data Mode|Invisible||||
SynchroMode|Synchro Mode|Synchro Config||||
FrameStartCode|Frame Start Code|Synchro Config||0|255|
FrameEndCode|Frame End Code|Synchro Config||0|255|
LineEndCode|Line End Code|Synchro Config||0|255|
LineStartCode|Line Start Code|Synchro Config||0|255|
Format|Format|Mode Config||||
DCMIPP_VPolarity|Vertical Polarity|Interface Capture Config||||
DCMIPP_HPolarity|Horizental Polarity|Interface Capture Config||||
DCMIPP_PCKPOLARITY|Clock polarity|Interface Capture Config||||
SwapBits|Swap lsb vs msb|Interface Capture Config||||
SwapCycles|Swap Data from cycle 0 vs cycle 1|Interface Capture Config||||
DCMIPP_PIPES|Pipe Number|Mode Config||||
FrameRate|FrameRate|Mode Config||||

[Values]
# параметр|значение|подпись
ExtendedDataMode|DCMIPP_INTERFACE_8BITS|Extended Data Mode
ExtendedDataMode|DCMIPP_INTERFACE_10BITS|Extended Data Mode
