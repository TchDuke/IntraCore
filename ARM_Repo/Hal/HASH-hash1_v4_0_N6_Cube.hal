# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=HASH
Version=hash1_v4_0_N6_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
Algorithm|Secure hash algorithm type|Algorithm||||Secure hash algorithm type. Default setting is SHA1
HASHMAC|HMAC operation|Parameters||||HMAC operation
DataType|Hash data type in bit|Parameters||||This parameter can be a value of @ref HASH_Data_Type: - HASH_NO_SWAP: 32-bit data(No swapping) - HASH_HALFWORD_SWAP: 16-bit data(Each half word is swapped) - HASH_BYTE_SWAP: 8-bit data(All bytes are swapped) - HASH_BIT_SWAP: 1-bit data(In the word all bits are swapped). Default setting is HASH_DATATYPE_32B
pKeyInputType|pKey input type|Parameters||||User can choose between HEXA or ASCII for pKey input type
pKeyInput|pKey user input|Parameters||||Used only in HMAC operation. Will be used to generate Encryption/Decryption key in right format.
KeySize|pkey size|Parameters||0|4294967295|Used only in HMAC operation.
pKey|pkey formatted in hexadecimal format|Parameters||||Used only in HMAC operation.
HASH_SUSPEND_RESUME|Hash suspend resume|Parameters||||

[Values]
# параметр|значение|подпись
Algorithm|HASH_ALGOSELECTION_SHA1|SHA1
Algorithm|HASH_ALGOSELECTION_MD5|MD5
Algorithm|HASH_ALGOSELECTION_SHA224|SHA224
Algorithm|HASH_ALGOSELECTION_SHA256|SHA256
Algorithm|HASH_ALGOSELECTION_SHA384|SHA384
Algorithm|HASH_ALGOSELECTION_SHA512_224|SHA512_224
Algorithm|HASH_ALGOSELECTION_SHA512_256|SHA512_256
Algorithm|HASH_ALGOSELECTION_SHA512|SHA512
DataType|HASH_NO_SWAP|32-bit data. No swapping
DataType|HASH_HALFWORD_SWAP|16-bit data. Each half word is swapped
DataType|HASH_BYTE_SWAP|8-bit data. All bytes are swapped
DataType|HASH_BIT_SWAP|1-bit data. In the word all bits are swapped
HASH_SUSPEND_RESUME|HASH_SUSPEND_NONE|0
HASH_SUSPEND_RESUME|HASH_SUSPEND|1
