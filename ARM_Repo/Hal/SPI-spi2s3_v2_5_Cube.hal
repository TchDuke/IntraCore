# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=SPI
Version=spi2s3_v2_5_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
Mode|Mode|Basic Parameters||||
Direction|Direction|Basic Parameters||||
TIMode|Frame Format|Basic Parameters||||
DataSize|Data Size|Basic Parameters||||
FirstBit|First Bit|Basic Parameters||0|1|
BaudRatePrescaler|Prescaler (for Baud Rate)|Clock Parameters||||
CalculateBaudRate|Baud Rate|Clock Parameters||0|150000000|Calculated Baudrate value based on SPI Clock source and Prescaler
CLKPolarity|Clock Polarity (CPOL)|Clock Parameters||0|1|
CLKPhase|Clock Phase (CPHA)|Clock Parameters||0|1|1 Edge means the first clock transition is the first data capture edge (value 0) AND 2 Edge means the second clock transition is the first data capture edge (value 1)
CRCCalculation|CRC Calculation|CRC Parameters||||
TxCRCInitializationPattern|Tx Crc Initialization Pattern|CRC Parameters||||
RxCRCInitializationPattern|Rx Crc Initialization Pattern|CRC Parameters||||
CRCLength|CRC Length|CRC Parameters||||
CRCPolynomial|CRC Polynomial [0x10:0xFFFFFFFF]|CRC Parameters||0x0|0xFFFF|
NSSPMode|NSSP Mode|Advanced Parameters||||
NSS|NSS Signal Type|Advanced Parameters||||
FifoThreshold|Fifo Threshold|Advanced Parameters||||
NSSPolarity|Nss Polarity|Advanced Parameters||||
MasterSSIdleness|Master Ss Idleness|Advanced Parameters||||Specifies an extra delay, expressed in number of SPI clock cycle periods, inserted additionally between active edge of SS and first data transaction start in master mode.
MasterInterDataIdleness|Master Inter Data Idleness|Advanced Parameters||||Specifies minimum time delay (expressed in SPI clock cycles periods) inserted between two consecutive data frames in master mode This parameter can be a value of SPI Master Inter-Data Ideleness.
MasterReceiverAutoSusp|Master Receiver Auto Susp|Advanced Parameters||||Control continuous SPI transfer in master receiver mode and automatic management in order to avoid overrun condition.
MasterKeepIOState|Master Keep Io State|Advanced Parameters||||Control of Alternate function GPIOs state This parameter can be a value of Keep IO State.
IOSwap|IO Swap|Advanced Parameters||||Invert MISO/MOSI alternate functions.
ReadyMasterManagement|Ready Master Management|Advanced Parameters||||RDY Master Signal management.
ReadyPolarity|Ready Signal Polarity|Advanced Parameters||||RDY Signal polarity.
TriggerState|State|Autonomous Mode||||Autonomous Mode activation.
TriggerSelection|Trigger Source|Autonomous Mode||||Autonomous Mode Trigger Source.
TriggerPolarity|Trigger Transition|Autonomous Mode||||Autonomous Mode Trigger Transition.
Interrupt1|Underrun Error|IP Internal Interrupt||||description
Interrupt2|Overrun Error|IP Internal Interrupt||||description
ORingInterrupt|Interrupt parameter for code generation __HAL_DAC_ENABLE_IT|||||

