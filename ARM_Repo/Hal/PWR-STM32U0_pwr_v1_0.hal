[Ip]
Name=PWR
Version=STM32U0_pwr_v1_0

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
PVDLevel|PVD detection Level|||||
Mode|PWR PVD Mode|||||Mode: Specifies the PVD trigger mode.
pwrSecureFull|PWR full secure|Secure PWR||||
PWR_WKUP1|Wake-Up 1 secure protection|Secure PWR||||
PWR_WKUP2|Wake-Up 2 secure protection|Secure PWR||||
PWR_WKUP3|Wake-Up 3 secure protection|Secure PWR||||
PWR_WKUP4|Wake-Up 4 secure protection|Secure PWR||||
PWR_WKUP5|Wake-Up 5 secure protection|Secure PWR||||
PWR_WKUP6|Wake-Up 6 secure protection|Secure PWR||||
PWR_WKUP7|Wake-Up 7 secure protection|Secure PWR||||
PWR_WKUP8|Wake-Up 8 secure protection|Secure PWR||||
HighImpedanceMode|High impedance mode|||||
VoltageScaling|Internal Voltage reference scale|||||
smartCodegenSys|Smart run domain in Run mode Call in MX_SystemPower_Config()|RAM||||
PowerMode|Power Regulator|System power supply||||

[Values]
# параметр|значение|подпись
PVDLevel|PWR_PVDLEVEL_7|PWR PVD LEVEL 7
PVDLevel|PWR_PVDLEVEL_0|PWR PVD LEVEL 0 (2.0 V)
