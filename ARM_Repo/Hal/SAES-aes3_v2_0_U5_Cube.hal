# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=SAES
Version=aes3_v2_0_U5_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
Algorithm|Data encryption type|Algorithm||||SAES Algorithm Mode encryption types list This parameter can be a value of @ref CRYP_Algorithm_Mode Possible values are: CRYP_AES_ECB: Electronic codebook chaining algorithm CRYP_AES_CBC: Cipher block chaining algorithm
DataType|Data type|Parameters||||AES Data Type selection: 32-bit data, 16-bit data, 8-bit data or 1-bit string. This parameter can be a value of @ref CRYP_Data_Type. Possible values are: CRYP_NO_SWAP: 32-bit data type (no swapping) CRYP_HALFWORD_SWAP: 16-bit data type (half-word swapping) CRYP_BYTE_SWAP: 8-bit data type (byte swapping) CRYP_BIT_SWAP: 1-bit data type (bit swapping)
KeySize|KeySize|Parameters||||Key size selection: 128 or 256 bit key length. This parameter can be a value of @ref CRYP_Key_Size. Possible values are: CRYP_KEYSIZE_128B: 128-bit long key CRYP_KEYSIZE_256B: 256-bit long key if you need to use Shared key between AES and SAES, then you must use the same key size
pKey|Encryption/Decryption key|Parameters||||Encryption/Decryption key
pInitVect|Initialization vector|Parameters||||Initialization Vector used for CBC mode
Header|Header|Parameters||||The header also known as Additional Authentication Data is used for authentication
HeaderInput|Header(Additional Authentication Data)|Parameters||||The header, also known as Additional Authentication Data in GCM mode is used as first part of the message just after the Initial Counter Block (ICB), and precede the plain text message. Input format: hexadecimal (ex: 0123456789abcdef)
HeaderSize|Header size|Parameters||4|4294967295|Header size in word
B0|B0|Parameters||||One 16-byte first authentication block, part of CBC-MAC mode Counter
DataWidthUnit|Data width unit|Parameters||||Payload Data Width Unit This parameter can be value of @ref CRYP_Data_Width_Unit Possible values are: CRYP_DATAWIDTHUNIT_WORD: By default, header size unit is word CRYP_DATAWIDTHUNIT_BYTE: Header size unit is byte
HeaderWidthUnit|Header width unit|Parameters||||Header Width Unit This parameter can be value of @ref CRYP_Header_Width_Unit Possible values are: CRYP_HEADERWIDTHUNIT_WORD: By default, header size unit is word CRYP_HEADERWIDTHUNIT_BYTE: Header size unit is byte
KeyIVConfigSkip|Key and IV configuration skip|Parameters||||CRYP peripheral Key and IV configuration skip, to config Key and Initialization Vector only once and to skip configuration for consecutive processings. This parameter can be a value of @ref CRYP_Configuration_Skip Possible values are: CRYP_KEYIVCONFIG_ALWAYS: Peripheral Key and IV configuration to do systematically CRYP_KEYIVCONFIG_ONCE: Peripheral Key and IV configuration to do only once CRYP_KEYNOCONFIG: Peripheral Key configuration to not do CRYP_IVCONFIG_ONCE: Peripheral IV configuration do once for interleave mode
KeyMode|Key mode|Parameters||||CRYP key Mode: This parameter can be a value of @ref CRYP_Key_Mode. Possible values are: CRYP_KEYMODE_NORMAL: Normal key usage, Key registers are freely useable CRYP_KEYMODE_WRAPPED: Shared key CRYP_KEYMODE_SHARED: Shared key
KeySelect|Key selection|Parameters||||CRYP key selection: This parameter can be a value of @ref CRYP_Key_Select. Possible values are: CRYP_KEYSEL_NORMAL: Normal key, key registers SAES_KEYx or CRYP_KEYx CRYP_KEYSEL_HW: Hardware key, derived hardware unique key (DHUK 256-bit) CRYP_KEYSEL_SW: Software key, boot hardware key BHK (256-bit) CRYP_KEYSEL_HSW: DHUK XOR BHK Hardware unique key XOR software key
KeyProtection|Key protection|Parameters||||AES key protection: This parameter can be a value of @ref AES_Key_Protection. Possible values are: CRYP_KEYPROT_ENABLE: Key protection between 2 applications with different security contexts CRYP_KEYPROT_DISABLE: Key not protected between 2 applications with different security contexts

[Values]
# параметр|значение|подпись
Algorithm|CRYP_AES_ECB|SAES ECB
Algorithm|CRYP_AES_CBC|SAES CBC
Algorithm|CRYP_AES_CTR|SAES CTR
Algorithm|CRYP_AES_GCM_GMAC|SAES GCM GMAC
Algorithm|CRYP_AES_CCM|SAES CCM
DataType|CRYP_NO_SWAP|CRYP_NO_SWAP
DataType|CRYP_HALFWORD_SWAP|CRYP_HALFWORD_SWAP
DataType|CRYP_BYTE_SWAP|CRYP_BYTE_SWAP
DataType|CRYP_BIT_SWAP|CRYP_BIT_SWAP
KeySize|CRYP_KEYSIZE_128B|128b
KeySize|CRYP_KEYSIZE_256B|256b
DataWidthUnit|CRYP_DATAWIDTHUNIT_WORD|Word
DataWidthUnit|CRYP_DATAWIDTHUNIT_BYTE|Byte
HeaderWidthUnit|CRYP_HEADERWIDTHUNIT_WORD|Word
HeaderWidthUnit|CRYP_HEADERWIDTHUNIT_BYTE|Byte
KeyIVConfigSkip|CRYP_KEYIVCONFIG_ALWAYS|CRYP_KEYIVCONFIG_ALWAYS
KeyIVConfigSkip|CRYP_KEYIVCONFIG_ONCE|CRYP_KEYIVCONFIG_ONCE
KeyIVConfigSkip|CRYP_KEYNOCONFIG|CRYP_KEYNOCONFIG
KeyIVConfigSkip|CRYP_IVCONFIG_ONCE|CRYP_IVCONFIG_ONCE
KeyMode|CRYP_KEYMODE_NORMAL|Normal key
KeyMode|CRYP_KEYMODE_WRAPPED|Wrapped key
KeyMode|CRYP_KEYMODE_SHARED|Shared key
KeySelect|CRYP_KEYSEL_NORMAL|Normal key
