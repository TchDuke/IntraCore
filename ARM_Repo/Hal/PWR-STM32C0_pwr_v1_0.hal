# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=PWR
Version=STM32C0_pwr_v1_0

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
HighImpedanceMode|High impedance mode|||||
VoltageScaling|Internal Voltage reference scale|||||
TrimmingMode|Trimming Mode|||||
TrimmingValue|Trimming Value|||0|63|
DisableDeadBatterySignalsConfig|UCPD Disable Dead Battery Signals|||||
PWR_LPM|Low power modes secure protection|Secure PWR||||
SYSCFG_Vrefint_OUTPUT|SYSCFG Vrefint OUTPUT|||||

[Values]
# параметр|значение|подпись
TrimmingMode|__NULL|Factory Trimming
TrimmingMode|USER_TRIMMING|User Trimming
PWR_LPM|LPM_SECURE_YES|Enable
PWR_LPM|LPM_SECURE_NO|Disable
