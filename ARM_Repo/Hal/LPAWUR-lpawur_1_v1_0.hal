# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=LPAWUR
Version=lpawur_1_v1_0

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
EnergyDetectorIcal|EnergyDetectorIcal|RF Config||||Current versus VBAT calibration
ClockDivider|ClockDivider|RF Config||0||Calibrate the 4kHz clock
EnergyDetectorSwitch|EnergyDetectorSwitch|RF Config||||Energy Detector as input switch (test mode) deactivated by default
AgcResetMode|AgcResetMode|RF Config||||The AGC reset behavior when the AGC is working in ON or HOLD mode
AgcHoldMode|AgcHoldMode|RF Config||||The behavior when the AGC is ON and is working in HOLD mode
AgcMode|AgcMode|RF Config||||Define the working mode of the AGC
AgcHiLvl|AgcHighLevel|RF Config||||Define the AGC level (High)
DCCurrentSubtraction|DCCurrentSubtraction|RF Config||||DC current subtraction enabling signal
AgcLoLvl|AgcLoLvl|RF Config||||Define the AGC level (Low)
TRecAlgoSel|TRecAlgoSel|Frame||||Timing recovery loop algorithm selection
SlowClkCyclePerBitCnt|SlowClkCyclePerBitCnt|Frame||0||The number of expected slow clock cycle per each manchester coded bit
PayloadLength|PayloadLength|Frame||0||The number of data Bytes in the payload (decoded)
SyncThr|SyncThr|Frame||||Detection threshold when receiving the Frame sync (Manchester encoded)
SyncLength|SyncLength|Frame||||Frame sync pattern length
PreambleThrCnt|PreambleThrCnt|Frame||0x0|0xFFFF|The number of transitions for preamble detection when receiving the Manchester encoded preamble
PreambleEnable|PreambleEnable|Frame||||Preamble detection enable
FrameSyncCntTimeout|FrameSyncCntTimeout|Frame||0x00|0xFFFF|The timeout in Manchester encoded bits for the Frame Sync
FrameSyncPattenHigh|FrameSyncPattenHigh|Frame||0x0|0xFFFF|The value of the frame sync pattern, High word, Manchester encoded
FrameSyncPatternLow|FrameSyncPatternLow|Frame||||
KpGain|KpGain|Frame||||
KiGain|KiGain|Frame||||

