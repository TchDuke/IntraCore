# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=CRYP
Version=cryp1_v2_0_N6_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
Algorithm|Data encryption algorithm|Algorithm||||AES/TDES Data encryption types list
DataType|Data type|Parameters||||AES/TDES Data Type selection: 32-bit data, 16-bit data, 8-bit data or 1-bit string. This parameter can be a value of @ref CRYP_Data_Type. Possible values are: CRYP_DATATYPE_32B: 32-bit data type (no swapping) CRYP_DATATYPE_16B: 16-bit data type (half-word swapping) CRYP_DATATYPE_8B: 8-bit data type (byte swapping) CRYP_DATATYPE_1B: 1-bit data type (bit swapping)
KeySize|Key size|Parameters||||Used only in AES mode: 128, 192 or 256 bit key length. This parameter can be a value of @ref CRYP_Key_Size. Possible values are: CRYP_KEYSIZE_128B CRYP_KEYSIZE_192B CRYP_KEYSIZE_256B
pKey|Encryption/Decryption key|Parameters||||pKey is the key used for Encryption/Decryption
pInitVect|Initialization vector|Parameters||||A 16-byte Initial Counter Block (ICB), composed of two distinct fields: – The initialization vector (IV): a 96-bit value that must be unique for each execution of the mode under a given key. Note that the GCM standard supports IV that are shorter than 96-bit, but in this case strict rules apply. – The counter: a 32-bit big-endian integer that is incremented each time a block has been processed. According to NIST specification, the counter value is 0x2 when processing the first block of payload.
Header|Header|Parameters||||The header also known as Additional Authentication Data is used for authentication
HeaderInput|Header|Parameters||||The header, also known as Additional Authentication Data in GCM mode is used as first part of the message just after the Initial Counter Block (ICB), and precede the plain text message. Input format: hexadecimal (ex: 0123456789abcdef)
HeaderSize|Header size|Parameters||4|4294967295|Header size in bytes
B0|B0|Parameters||||One 16-byte first authentication block, part of CBC-MAC mode Counter
DataWidthUnit|Data width unit|Parameters||||Data With Unit.By default, size unit is word
HeaderWidthUnit|Header width unit|Parameters||||Header Width Unit This parameter can be value of @ref CRYP_Header_Width_Unit Possible values are: CRYP_HEADERWIDTHUNIT_WORD: By default, header size unit is word CRYP_HEADERWIDTHUNIT_BYTE: Header size unit is byte
KeyIVConfigSkip|Key and IV configuration skip|Parameters||||This parameter can be a value of @ref CRYP_Configuration_Skip Possible values are: CRYP_KEYIVCONFIG_ALWAYS: Peripheral Key and IV configuration to do systematically CRYP_KEYIVCONFIG_ONCE: Peripheral Key and IV configuration to do only once
KeyMode|Key mode|Parameters||||CRYP key Mode: This parameter can be a value of @ref CRYP_Key_Mode. Possible values are: CRYP_KEYMODE_NORMAL: Normal key usage, Key registers are freely useable CRYP_KEYMODE_SHARED: Shared key

[Values]
# параметр|значение|подпись
Algorithm|CRYP_AES_ECB|AES ECB
Algorithm|CRYP_AES_CBC|AES CBC
Algorithm|CRYP_AES_KEY|AES KEY
Algorithm|CRYP_AES_CTR|AES CTR
Algorithm|CRYP_AES_GCM|AES GCM
Algorithm|CRYP_AES_CCM|AES CCM
DataType|CRYP_DATATYPE_32B|32b(no swapping)
DataType|CRYP_DATATYPE_16B|16b(half-word swapping)
DataType|CRYP_DATATYPE_8B|8b(byte swapping)
DataType|CRYP_DATATYPE_1B|1b(bit swapping)
KeySize|CRYP_KEYSIZE_128B|128b
KeySize|CRYP_KEYSIZE_192B|192b
KeySize|CRYP_KEYSIZE_256B|256b
DataWidthUnit|CRYP_DATAWIDTHUNIT_WORD|Word
DataWidthUnit|CRYP_DATAWIDTHUNIT_BYTE|Byte
HeaderWidthUnit|CRYP_HEADERWIDTHUNIT_WORD|Word
HeaderWidthUnit|CRYP_HEADERWIDTHUNIT_BYTE|Byte
KeyIVConfigSkip|CRYP_KEYIVCONFIG_ALWAYS|Always
KeyIVConfigSkip|CRYP_KEYIVCONFIG_ONCE|Once
KeyMode|CRYP_KEYMODE_NORMAL|Normal key
KeyMode|CRYP_KEYMODE_SHARED|Shared key
