# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=I2S
Version=spi2s2_v1_1_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
VirtualMode|Mode|Generic Parameters||||
Mode|Transmission Mode|Generic Parameters||||
FullDuplexMode|Full-Duplex Mode|Generic Parameters||||
Standard|Communication Standard|Generic Parameters||||
DataFormat|Data and Frame Format|Generic Parameters||||
AudioFreq|Selected Audio Frequency|Generic Parameters||||
AudioFreqCustom|Custom I2S Frequency (Hz)|Generic Parameters|Hz|8000|192000|Value must be enterred as a 1000 multiple
RealAudioFreq|Real Audio Frequency|Generic Parameters||||
ErrorAudioFreq|Error between Selected and Real|Generic Parameters||||
MCLKOutput|Master Clock Output|Clock Parameters||||
ClockSource|Clock Source|Clock Parameters||||
CPOL|Clock Polarity|Clock Parameters||||
FirstBit|First Bit|Advanced Parameters||||Specifies whether data transfers start from MSB or LSB bit.
WSInversion|Ws Inversion|Advanced Parameters||||Control the Word Select Inversion.
IOSwap|Io Swap|Advanced Parameters||||Invert MISO/MOSI alternate functions This parameter can be a value of Control I2S IO Swap
Data24BitAlignment|Data24 Bit Alignment|Advanced Parameters||||Specifies the Data Padding for 24 bits data lenght This parameter can be a value of Data Padding 24Bit
FifoThreshold|Fifo Threshold|Advanced Parameters||||Specifies the FIFO threshold level.
MasterKeepIOState|Master Keep Io State|Advanced Parameters||||Control of Alternate function GPIOs state This parameter can be a value of Keep IO State
SlaveExtendFREDetection|Slave Extend Fre Detection|Advanced Parameters||||Control the channel length in SLAVE.

[Values]
# параметр|значение|подпись
VirtualMode|I2S_MODE_MASTER|Master
VirtualMode|I2S_MODE_SLAVE|Slave
Mode|I2S_MODE_MASTER_TX|Mode Master Transmit
