# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=KMS
Version=v1.1.9_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
KMS_Version|KMS version|Version||||
NULL|NULL|||||
KMS_EXT_TOKEN_ENABLED|support External Token|Hardware Configuration||||KMS_EXT_TOKEN_ENABLED : to support External Token
KMS_NVM_ENABLED|support Non Volatile Memory storage|Storage Configuration||||KMS_NVM_ENABLED : to support Non Volatile Memory storage Mandatory to handle runtime objects addition through blob import or creation through specific KMS services Requires @ref KMS_NVM_SLOT_NUMBERS to be defined
KMS_NVM_DYNAMIC_ENABLED|support Dynamic Non Volatile Memory storage|Storage Configuration||||KMS_NVM_DYNAMIC_ENABLED : to support Non Volatile Memory storage Mandatory to handle runtime objects creation through specific KMS services Requires "support Non Volatile Memory storage" (KMS_NVM_ENABLED) to be defined
KMS_NVM_SLOT_NUMBERS|number of slots to use in the Non Volatile Memory storage|Storage Configuration||1|300|KMS_NVM_SLOT_NUMBERS : Specify here the number of slots to use in the Non Volatile Memory storage NVM slots correspond to storage slots, it should be at least equal to the number of keys you'll store into NVM. But if you intend to manipulate objects (create, destroy, derivate...) better use a greater number to avoid too much erase of the flash sectors containing the NVM storage. Memory impact is a 4 bytes per slot to store slot address in NVM. Mandatory to set if "support Non Volatile Memory storage" (KMS_NVM_ENABLED) is defined
KMS_VM_DYNAMIC_ENABLED|support Dynamic Volatile Memory storage|Storage Configuration||||KMS_VM_DYNAMIC_ENABLED : to support Volatile Memory storage Mandatory to handle runtime objects creation through specific KMS services
KMS_VM_SLOT_NUMBERS|number of slots to use in the Volatile Memory storage|Storage Configuration||1|300|KMS_VM_SLOT_NUMBERS : Specify here the number of slots to use in the Volatile Memory storage VM slots correspond to storage slots, it should be at least equal to the number of keys you'll store into VM. Memory impact is a 4 bytes per slot to store slot address in VM. Mandatory to set if "support Non Volatile Memory storage" (KMS_VM_DYNAMIC_ENABLED) is defined
KMS_NB_SESSIONS_MAX|number of sessions KMS will be able to handle in parallel|Services Configuration||1|50|KMS_NB_SESSIONS_MAX : Defines the number of sessions KMS will be able to handle in parallel This value has an impact on memory footprint
KMS_ENCRYPT|support encryption services|PKCS#11 Services Configuration||||KMS_ENCRYPT : to support encryption services Requires a supported encryption algorithm to be enabled too: - KMS_AES_CBC - KMS_AES_CCM - KMS_AES_ECB - KMS_AES_GCM
KMS_DECRYPT|support decryption services|PKCS#11 Services Configuration||||KMS_DECRYPT : to support decryption services Requires a supported decryption algorithm to be enabled too: - KMS_AES_CBC - KMS_AES_CCM - KMS_AES_ECB - KMS_AES_GCM
KMS_DIGEST|support digest services|PKCS#11 Services Configuration||||KMS_DIGEST : to support digest services Requires a supported digest algorithm to be enabled too: - KMS_SHA1 - KMS_SHA256
KMS_SIGN|support signature services|PKCS#11 Services Configuration||||KMS_SIGN : to support signature services Requires a supported signature algorithm to be enabled too: - KMS_RSA1 - KMS_AES_CMAC
KMS_VERIFY|support verification services|PKCS#11 Services Configuration||||KMS_VERIFY : to support verification services Requires a supported verification algorithm to be enabled too: - KMS_RSA1 - KMS_ECDSA - KMS_AES_CMAC
KMS_DERIVE_KEY|support key derivation services|PKCS#11 Services Configuration||||KMS_DERIVE_KEY : to support key derivation services Requires a supported derivation algorithm to be enabled too: - KMS_AES_ECB <!-- - KMS_ECDSA --> Requires KMS_NVM_DYNAMIC_ENABLED to be enabled to store derived key into NVM or @ref KMS_VM_DYNAMIC_ENABLED to be enabled to store derived key into VM
KMS_SEARCH|support key search or mechanism search services|PKCS#11 Services Configuration||||KMS_SEARCH : to support key search or mechanism search services
KMS_GENERATE_KEYS|support key generation services|PKCS#11 Services Configuration||||KMS_GENERATE_KEYS : to support key generation services Requires a supported key generation algorithm to be enabled too: - KMS_ECDSA Requires KMS_NVM_DYNAMIC_ENABLED to be enabled to store generated key into NVM or @ref KMS_VM_DYNAMIC_ENABLED to be enabled to store generated key into VM
KMS_ATTRIBUTES|support attributes manipulation services|PKCS#11 Services Configuration||||KMS_ATTRIBUTES : to support attributes manipulation services Requires @ref KMS_NVM_DYNAMIC_ENABLED or @ref KMS_VM_DYNAMIC_ENABLED to be enabled in order to modify attributes
KMS_OBJECTS|support objects manipulation services|PKCS#11 Services Configuration||||KMS_OBJECTS : to support objects manipulation services Requires KMS_NVM_DYNAMIC_ENABLED to be enabled to create or delete objects into NVM or @ref KMS_VM_DYNAMIC_ENABLED to be enabled to create or delete objects into VM
KMS_PKCS11_GET_FUNCTION_LIST_SUPPORT|support C_GetFunctionList API|PKCS#11 Services Configuration||||KMS_PKCS11_GET_FUNCTION_LIST_SUPPORT : to support C_GetFunctionList API Disabling this feature allows to save some code footprint
KMS_PKCS11_COMPLIANCE|support PKCS11 APIs and implementation that are required to be compliant with PKCS11 standard|PKCS#11 Services Configuration||||KMS_PKCS11_COMPLIANCE : to support PKCS11 APIs and implementation that are required to be compliant with PKCS11 standard Disabling this feature allows to save some code footprint
KMS_NIKMS_ROUTER_BYPASS|bypass KMS router and perform direct KMS API calls|PKCS#11 Services Configuration||||KMS_NIKMS_ROUTER_BYPASS : to bypass KMS router and perform direct KMS API calls Only applicable when using 'niKMS' access Enabling this feature allows to save some code footprint, but forbid any use of the external token services
KMS_IMPORT_BLOB|use vendor defined blob import features|PKCS#11 Services Configuration||||KMS_IMPORT_BLOB : to use vendor defined blob import features Requires KMS_NVM_ENABLED to store imported keys Requires the following services and algorithm to Authenticate, Verify and decrypt the imported blobs: - KMS_DECRYPT - KMS_AES_CBC - KMS_DIGEST - KMS_SHA256 - KMS_VERIFY - KMS_ECDSA - KMS_EC_SECP256
KMS_IMPORT_BLOB_CHUNK_SIZE|Configure the blob importation chunk size|PKCS#11 Services Configuration||0||KMS_IMPORT_BLOB_CHUNK_SIZE : Configure the blob importation chunk size - This size must be a multiple of 4 - This size must be greater to at least the blob import header size (@ref KMS_BlobRawHeaderTypeDef) Requires KMS_IMPORT_BLOB to be enabled
KMS_ENCRYPT_DECRYPT_BLOB|enable the encryption of the blobs within the KMS data storage|PKCS#11 Services Configuration||||KMS_ENCRYPT_DECRYPT_BLOB : Enable the encryption of the blobs within the KMS data storage Requires KMS_VM_DYNAMIC_ENABLED to be defined
KMS_SECURE_COUNTERS|support KMS secure counters|PKCS#11 Services Configuration||||KMS_SECURE_COUNTERS : to support KMS secure counters Mandatory to handle counter objects through specific KMS services Requires @ref KMS_NVM_ENABLED or @ref KMS_VM_DYNAMIC_ENABLED to be defined
KMS_MEM_USE_ALLOCATOR|perform dynamic allocation|Memory management Configuration||||KMS_MEM_USE_HEAP_ALLOCATOR : to perform dynamic allocation in HEAP - KMS will use standard malloc and free APIs - Requires a dynamic allocator provided by the toolchain like dlmalloc KMS_MEM_USE_POOL_ALLOCATOR : to perform dynamic allocation using internal pool allocator - Requires a pool definition in a file called kms_mem_pool_def.h (see kms_mem_pool_def_template.h for example) KMS_MEM_USE_CUSTOM_ALLOCATOR : to perform dynamic allocation using a custom allocator To use this custom allocator, implement the kms_mem_low_level.c - void KMS_MemInit(void) - CK_VOID_PTR KMS_Alloc(CK_SESSION_HANDLE session, size_t size) - void KMS_Free(CK_SESSION_HANDLE session, CK_VOID_PTR ptr)
KMS_MEM_USE_HEAP_ALLOCATOR|perform dynamic allocation in HEAP|Memory management Configuration||||KMS_MEM_USE_HEAP_ALLOCATOR : to perform dynamic allocation in HEAP - KMS will use standard malloc and free APIs - Requires a dynamic allocator provided by the toolchain like dlmalloc KMS_MEM_USE_HEAP_ALLOCATOR, KMS_MEM_USE_POOL_ALLOCATOR and KMS_MEM_USE_CUSTOM_ALLOCATOR are mutually exclusive
KMS_MEM_USE_POOL_ALLOCATOR|perform dynamic allocation using internal pool allocator|Memory management Configuration||||KMS_MEM_USE_POOL_ALLOCATOR : to perform dynamic allocation using internal pool allocator - Requires a pool definition in a file called kms_mem_pool_def.h (see kms_mem_pool_def_template.h for example) KMS_MEM_USE_HEAP_ALLOCATOR, KMS_MEM_USE_POOL_ALLOCATOR and KMS_MEM_USE_CUSTOM_ALLOCATOR are mutually exclusive
KMS_MEM_USE_CUSTOM_ALLOCATOR|perform dynamic allocation using custom allocator|Memory management Configuration||||KMS_MEM_USE_CUSTOM_ALLOCATOR : to perform dynamic allocation using a custom allocator To use this custom allocator, implement the kms_mem_low_level.c - void KMS_MemInit(void) - CK_VOID_PTR KMS_Alloc(CK_SESSION_HANDLE session, size_t size) - void KMS_Free(CK_SESSION_HANDLE session, CK_VOID_PTR ptr) KMS_MEM_USE_HEAP_ALLOCATOR, KMS_MEM_USE_POOL_ALLOCATOR and KMS_MEM_USE_CUSTOM_ALLOCATOR are mutually exclusive
KMS_MEM_DEBUGGING|keep memory profiling information|Memory management Configuration||||KMS_MEM_DEBUGGING : to keep memory profiling information Not usable with KMS_MEM_USE_CUSTOM_ALLOCATOR
KMS_MEM_CLEANING|clean dynamically freed memory|Memory management Configuration||||KMS_MEM_CLEANING : to clean dynamically freed memory The freed memory will be reset to 0 If using KMS_MEM_USE_HEAP_ALLOCATOR, KMS_MEM_DEBUGGING required Not usable with KMS_MEM_USE_CUSTOM_ALLOCATOR
KMS_MEM_LOGGING|log memory allocation information|Memory management Configuration||||KMS_MEM_LOGGING : to log memory allocation information Information about allocations will be transmitted to KMS_LL_ReportMemAlloc and KMS_LL_ReportMemFree Not usable with KMS_MEM_USE_CUSTOM_ALLOCATOR
KMS_SE_CHECK_PARAMS|check input & output parameters location vs secure enclave|Security Enforcement Configuration||||KMS_SE_CHECK_PARAMS : to check input & output parameters location vs secure enclave Secure enforcement only applicable when using iKMS and secure enclave
KMS_SE_LOCK_KEYS|use key locking services|Security Enforcement Configuration||||KMS_SE_CHECK_PARAMS : to use key locking services Secure enforcement only applicable when using iKMS and secure enclave
KMS_SE_LOCK_KEYS_MAX|the number of keys that can be locked|Security Enforcement Configuration||||KMS_SE_LOCK_KEYS_MAX : the number of keys that can be locked Mandatory to set if KMS_SE_LOCK_KEYS is defined
KMS_SE_LOCK_SERVICES|use services locking services|Security Enforcement Configuration||||KMS_SE_LOCK_SERVICES : to use services locking services Secure enforcement only applicable when using iKMS and secure enclave
KMS_SE_LOCK_SERVICES_MAX|the number of services that can be locked|Security Enforcement Configuration||||KMS_SE_LOCK_SERVICES_MAX : the number of services that can be locked Mandatory to set if KMS_SE_LOCK_SERVICES is defined
KMS_ACTIVATED_Encrypt_Service|encryption service|Features Configuration||||
KMS_ACTIVATED_Decrypt_Service|decryption service|Features Configuration||||
KMS_ACTIVATED_Derive_Key_Service|key derivation service|Features Configuration||||
KMS_ACTIVATED_Generate_Key_Service|key generation service|Features Configuration||||
KMS_ACTIVATED_Sign_Service|signature service|Features Configuration||||
KMS_ACTIVATED_Verify_Service|verification service|Features Configuration||||
KMS_ACTIVATED_Digest_Service|digest service|Features Configuration||||
KMS_AES_CBC|support AES CBC algorithm|Features Configuration||||KMS_AES_CBC : to support AES CBC algorithm This defines is a bit mask that include information on the algorithm purpose: - KMS_FCT_ENCRYPT This algorithm can be used to perform encryption - KMS_FCT_DECRYPT This algorithm can be used to perform decryption Requires at least one of the following PKCS#11 services to be enabled: - KMS_ENCRYPT - KMS_DECRYPT
KMS_AES_CCM|support AES CCM algorithm|Features Configuration||||KMS_AES_CCM : to support AES CCM algorithm This defines is a bit mask that include information on the algorithm purpose: - KMS_FCT_ENCRYPT This algorithm can be used to perform encryption - KMS_FCT_DECRYPT This algorithm can be used to perform decryption Requires at least one of the following PKCS#11 services to be enabled: - KMS_ENCRYPT - KMS_DECRYPT
KMS_AES_ECB|support AES ECB algorithm|Features Configuration||||KMS_AES_ECB : to support AES ECB algorithm This defines is a bit mask that include information on the algorithm purpose: - KMS_FCT_ENCRYPT This algorithm can be used to perform encryption - KMS_FCT_DECRYPT This algorithm can be used to perform decryption - KMS_FCT_DERIVE_KEY This algorithm can be used to perform key derivation Requires at least one of the following PKCS#11 services to be enabled: - KMS_ENCRYPT - KMS_DECRYPT - KMS_DERIVE_KEY
KMS_AES_GCM|support AES GCM algorithm|Features Configuration||||KMS_AES_GCM : to support AES GCM algorithm This defines is a bit mask that include information on the algorithm purpose: - KMS_FCT_ENCRYPT This algorithm can be used to perform encryption - KMS_FCT_DECRYPT This algorithm can be used to perform decryption Requires at least one of the following PKCS#11 services to be enabled: - KMS_ENCRYPT - KMS_DECRYPT
KMS_AES_CMAC|support AES CMAC algorithm|Features Configuration||||KMS_AES_CMAC : to support AES CMAC algorithm This defines is a bit mask that include information on the algorithm purpose: - KMS_FCT_SIGN This algorithm can be used to perform signature - KMS_FCT_VERIFY This algorithm can be used to perform verification Requires at least one of the following PKCS#11 services to be enabled: - KMS_SIGN - KMS_VERIFY
KMS_RSA|support RSA algorithm|Features Configuration||||KMS_RSA : to support RSA algorithm This defines is a bit mask that include information on the algorithm purpose: - KMS_FCT_SIGN This algorithm can be used to perform signature - KMS_FCT_VERIFY This algorithm can be used to perform verification Requires at least one of the following PKCS#11 services to be enabled: - KMS_SIGN - KMS_VERIFY Requires at least one of the following RSA modulus length to be enabled: - KMS_RSA_1024 - KMS_RSA_2048
KMS_RSA_Modulus|RSA algorithm|Features Configuration||||
KMS_RSA_1024|support RSA 1024 bits modulus length|Features Configuration||||KMS_RSA_1024 : to support RSA 1024 bits modulus length Requires KMS_RSA to be defined
KMS_RSA_2048|support RSA 2048 bits modulus length|Features Configuration||||KMS_RSA_2048 : to support RSA 2048 bits modulus length Requires KMS_RSA to be defined
KMS_ECDSA|support ECDSA algorithm|Features Configuration||||KMS_ECDSA Uncomment the below line to support ECDSA algorithm This defines is a bit mask that include information on the algorithm purpose: - KMS_FCT_VERIFY This algorithm can be used to perform verification <!-- - KMS_FCT_DERIVE_KEY This algorithm can be used to perform key derivation - KMS_FCT_GENERATE_KEYS This algorithm can be used to perform key generation --> Requires at least one of the following PKCS#11 services to be enabled: - KMS_VERIFY <!-- - KMS_DERIVE_KEY - KMS_GENERATE_KEYS --> Requires at least one of the following elliptic curve to be enabled: - KMS_EC_SECP192 - KMS_EC_SECP256 - KMS_EC_SECP384
KMS_ECDSA_Elliptic_Curve|ECDSA algorithm|Features Configuration||||
KMS_EC_SECP192|support elliptic curve SECP-192|Features Configuration||||KMS_EC_SECP192 : to support elliptic curve SECP-192 Requires KMS_ECDSA to be defined
KMS_EC_SECP256|support elliptic curve SECP-256|Features Configuration||||KMS_EC_SECP256 : to support elliptic curve SECP-256 Requires KMS_ECDSA to be defined
KMS_EC_SECP384|support elliptic curve SECP-384|Features Configuration||||KMS_EC_SECP384 : to support elliptic curve SECP-384 Requires KMS_ECDSA to be defined
KMS_SHA1|support SHA1 digest algorithm|Features Configuration||||KMS_SHA1 : to support SHA1 algorithm This defines is a bit mask that include information on the algorithm purpose: - KMS_FCT_DIGEST This algorithm can be used to perform digesting Requires at least one of the following PKCS#11 services to be enabled: - KMS_DIGEST
KMS_SHA256|support SHA256 digest algorithm|Features Configuration||||KMS_SHA256 : to support SHA256 algorithm This defines is a bit mask that include information on the algorithm purpose: - KMS_FCT_DIGEST This algorithm can be used to perform digesting Requires at least one of the following PKCS#11 services to be enabled: - KMS_DIGEST

[Values]
# параметр|значение|подпись
KMS_MEM_USE_ALLOCATOR|KMS_MEM_USE_HEAP_ALLOCATOR|in HEAP
KMS_MEM_USE_ALLOCATOR|KMS_MEM_USE_POOL_ALLOCATOR|using internal pool allocator
KMS_MEM_USE_ALLOCATOR|KMS_MEM_USE_CUSTOM_ALLOCATOR|using a custom allocator
