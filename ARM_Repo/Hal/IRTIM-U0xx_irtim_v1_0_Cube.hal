# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=IRTIM
Version=U0xx_irtim_v1_0_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
Polarity|output polarity|||||
InputSelection|IR Modulation Envelope signal selection|||||

[Values]
# параметр|значение|подпись
Polarity|__NULL|Polarity not inverted
Polarity|HAL_SYSCFG_IRDA_POLARITY_NOT_INVERTED|Polarity not inverted
Polarity|HAL_SYSCFG_IRDA_POLARITY_INVERTED|Polarity inverted
InputSelection|HAL_SYSCFG_IRDA_ENV_SEL_TIM16|TIM16
InputSelection|HAL_SYSCFG_IRDA_ENV_SEL_USART1|USART1
InputSelection|HAL_SYSCFG_IRDA_ENV_SEL_USART4|USART4
InputSelection|HAL_SYSCFG_IRDA_ENV_SEL_USART2|USART2
