# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=ADC
Version=aditf4_v1_1_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
FadcConstraint|Fadc Constraint|||600000|14000000|
ClockPrescaler|Clock Prescaler|ADCgroup||||frequency of the clock to the ADC. The clock is common for all the ADCs.
Resolution|Resolution|ADCgroup||||Resolution of the ADC conversion
DataAlign|Data Alignment|ADCgroup||||Select the alignment of the data stored after conversion.
ScanConvMode|Scan Conversion Mode|ADCgroup||||Configurable Scan Conversion Mode (Upward from channel 0 to channel 18 or Backward from channel 18 to channel 0)
ContinuousConvMode|Continuous Conversion Mode|ADCgroup||||Enable or Disable the Continuous Conversion Mode
DiscontinuousConvMode|Discontinuous Conversion Mode|||||Enable or Disable the Discontinuous Conversion Mode
DMAContinuousRequests|DMA Continuous Requests|ADCgroup||||This parameter is used only when a DMA Request is configured. Else it is not relevant. When the DMA Request for this ADC instance this parameter specifies whether the DMA requests are performed in one shot mode (DMA transfer stops when number of conversions is reached) or are performed in continuous mode (DMA transfer unlimited, whatever number of conversions). Note: In continuous mode, DMA must be configured in circular mode. Otherwise an overrun will be triggered when DMA buffer maximum pointer is reached.
EOCSelection|End Of Conversion Selection|ADCgroup||||Regular channel end of conversion selection
Overrun|Overrun behaviour|ADCgroup||||Select the behaviour in case of overrun
LowPowerAutoWait|Low Power Auto Wait|||||Specifies the usage of dynamic low power Auto Delay: New conversion start only when the previous conversion (for regular channel) is completed.
LowPowerAutoPowerOff|Low Power Auto Power Off|||||Enable or Disable the auto-off mode: the ADC automatically powers-off after a conversion and automatically wakes-up when a new conversion is triggered.
AutoOff|Auto Off|||||The ADC is always powered off when not converting and automatically wakes-up when a conversion is started
ScanDirection|Scan Direction|ADCgroup||||Configurable scan direction (Upward from channel 0 to 18 or Backward from channel 18 to channel 0)
ExternalTrigConv|External Trigger Conversion Source|ADCgroup||||Select the external event used to trigger the start of conversion of a regular group
ExternalTrigConvEdge|External Trigger Conversion Edge|ADCgroup||||Select the external trigger polarity and enable the trigger of a regular group: When an external trigger is selected for ADC regular or injected conversion, only the rising edge of the signal can start the conversion.
Rank|Rank|||||The rank in the regular group sequencer
RankMode|RankMode|ADCChannel||||The rank in the regular group sequencer
ChannelVREF|ChannelVREF|||||
ChannelTS|ChannelTS|||||
ChannelVBAT|ChannelVBAT|||||
Channel|Channel|ADCChannel||||
SamplingTime|Sampling Time|ADCChannel||||Regular Channel x sampling time selection
EnableAnalogWatchDog|Enable Analog WatchDog Mode|ADCgroup||||Enable/Disable Analog WatchDog Mode
WatchdogMode|Watchdog Mode|ADCgroup||||Configures the ADC analog watchdog mode.
WatchdogChannel|Analog WatchDog Channel|ADCChannel||||ADC channel for the analog watchdog
AWD1HighThreshold|High Threshold|ADCgroup||=AWD1LowThreshold|4095|Configures the ADC analog watchdog High threshold value.
AWD1LowThreshold|Low Threshold|ADCgroup||0|=AWD1HighThreshold|Configures the ADC analog watchdog Low threshold value.
ITMode|Interrupt Mode|ADCgroup||||Specifies whether the analog watchdog is configured in interrupt mode or in polling mode.
master|Master Flag|||0|1|
AllChannels|Channel|ADCChannel||||
AnalogWDChannel|Analog WatchDog Channel|ADCChannel||||ADC channel for the analog watchdog
ChannelForWatchDog|Channel type for WatchDog|||||

[Values]
# параметр|значение|подпись
ClockPrescaler|ADC_CLOCK_ASYNC_DIV1|Asynchronous clock mode
ClockPrescaler|ADC_CLOCK_SYNC_PCLK_DIV2|Synchronous clock mode divided by 2
ClockPrescaler|ADC_CLOCK_SYNC_PCLK_DIV4|Synchronous clock mode divided by 4
Resolution|ADC_RESOLUTION_12B|ADC 12-bit resolution
Resolution|ADC_RESOLUTION_10B|ADC 10-bit resolution
Resolution|ADC_RESOLUTION_8B|ADC 8-bit resolution
Resolution|ADC_RESOLUTION_6B|ADC 6-bit resolution
DataAlign|ADC_DATAALIGN_RIGHT|Right alignment
DataAlign|ADC_DATAALIGN_LEFT|Left alignment
ScanConvMode|ADC_SCAN_DIRECTION_FORWARD|Forward
ScanConvMode|ADC_SCAN_DIRECTION_BACKWARD|Backward
EOCSelection|ADC_EOC_SINGLE_CONV|End of single conversion
EOCSelection|ADC_EOC_SEQ_CONV|End of sequence of conversion
Overrun|ADC_OVR_DATA_PRESERVED|Overrun data preserved
Overrun|ADC_OVR_DATA_OVERWRITTEN|Overrun data overwritten
ScanDirection|ADC_SCAN_DIRECTION_FORWARD|Forward (from channel 0 to 18)
ScanDirection|ADC_SCAN_DIRECTION_BACKWARD|Backward (from channel 18 to channel 0)
ExternalTrigConv|ADC_SOFTWARE_START|Regular Conversion launched by software
ExternalTrigConv|ADC_EXTERNALTRIGCONV_T1_TRGO|Timer 1 Trigger Out event
ExternalTrigConv|ADC_EXTERNALTRIGCONV_T1_CC4|Timer 1 Capture Compare 4 event
ExternalTrigConv|ADC_EXTERNALTRIGCONV_T2_TRGO|Timer 2 Trigger Out event
ExternalTrigConv|ADC_EXTERNALTRIGCONV_T3_TRGO|Timer 3 Trigger Out event
ExternalTrigConv|ADC_EXTERNALTRIGCONV_T15_TRGO|Timer 15 Trigger Out event
ExternalTrigConvEdge|ADC_EXTERNALTRIGCONVEDGE_NONE|None
ExternalTrigConvEdge|ADC_EXTERNALTRIGCONVEDGE_RISING|Trigger detection on the rising edge
ExternalTrigConvEdge|ADC_EXTERNALTRIGCONVEDGE_FALLING|Trigger detection on the falling edge
ExternalTrigConvEdge|ADC_EXTERNALTRIGCONVEDGE_RISINGFALLING|Trigger detection on the rising and fallings edges
Rank|ADC_RANK_CHANNEL_NUMBER|ADC_RANK_CHANNEL_NUMBER
RankMode|ADC_RANK_CHANNEL_NUMBER|Enable the rank of the selected channels. Rank is defined by each channel number (channel 0 fixed on rank 0, channel 1 fixed on rank1, ...)
RankMode|ADC_RANK_NONE|Disable the selected rank (selected channel) from sequencer
ChannelVREF|ADC_CHANNEL_VREFINT|ADC_CHANNEL_VREFINT
