# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=I2C
Version=i2c1_v1_5_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
I2C_Speed_Mode|I2C Speed Mode|Timing configuration||||
I2C_Mode|I2C Speed Mode|Master Features||||
SMBusAnalogFilter|Analog Filter|Timing configuration||||
Analog_Filter|Analog Filter|Timing configuration||||
I2C_Coeff_DF|Coefficient of Digital Filter|Timing configuration||0|15|
ClockSpeed|I2C Clock Speed (Hz)|Master Features||1|100000|Fast up to 400 Khz
SmbusClockSpeed|Clock Speed (Hz)|Timing configuration||1|100000|standard up to 100KHz
DutyCycle|Fast Mode Duty Cycle|Master Features||||
OwnAddress|Primary slave address|Slave Features||0|1023|The generated value of the address is shifted left by 1 bit.
OwnAddress1|Primary slave address|Slave Features||0|1023|The generated value of the address is shifted left by 1 bit.
AddressingMode|Primary Address Length selection|Slave Features||||
OwnAddress2|Secondary slave address|Slave Features||0|127|The generated value of the address is shifted left by 1 bit.
OwnAddress22|Secondary slave address|Slave Features||0|127|
DualAddressMode|Dual Address Acknowledged|Slave Features||||
GeneralCallMode|General Call address detection|Slave Features||||
NoStretchMode|Clock No Stretch Mode|Slave Features||||
OwnAddress2Masks|Secondary Address Mask|Slave Features||||
TIDLE|Idle Clock Timeout Detection|Timeout configuration||||
Timeout|Timeout|Timeout configuration||||
SMBusPacketErrorCheckMode|Packet Error Check Mode|SMBus Features||||
SMBusPeripheralMode|Peripheral Mode|SMBus Features||||In case of switching your device form Slave ARP to Master (Peripheral mode SMBus Master) on your application, you need to set addressing mode parameters. And if you are using SMBUS device protocol and Host mode(Peripheral mode SMBus Master), please make sure that there may be at most one host in your system.
SMBusAddressingMode|Primary Address Length selection|SMBus Slave Features||||The Parameter " SMBusAddressingMode " is not supported by LL Driver
SMBusOwnAddress|Primary slave address|SMBus Slave Features||1|1023|The generated value of the address is shifted left by 1 bit.
SMBusOwnAddress1|Primary slave address|SMBus Slave Features||0|1023|
SMBusOwnAddress2|Secondary slave address|SMBus Slave Features||0|127|The generated value of the address is shifted left by 1 bit.
SMBusOwnAddress22|Secondary slave address|SMBus Slave Features||0|127|
SMBusDualAddressMode|Dual Address Acknowledged|SMBus Slave Features||||The Parameter " SMBusDualAddressMode " is not supported by LL Driver
SMBusGeneralCallMode|General Call Address Detection|SMBus Slave Features||||
SMBusNoStretchMode|Clock No Stretch Mode|SMBus Slave Features||||
SMBusOwnAddress2Masks|Secondary Address Mask|SMBus Slave Features||||

