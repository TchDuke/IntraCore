# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=DAC
Version=WL33_dacif_v3_0_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
DAC_Channel|Channel|||||
DAC_Trigger|Trigger|||||Specifies the external trigger for the selected DAC channel.
DAC_OutputBuffer|Output Buffer|||||
TriangleAmplitude|Triangle Amplitude|||||
NoiseAmplitude|Noise Amplitude|||||
WaveGeneration|Wave generation mode|||||
DAC1_ConnectOnChipPeripheral|Connect On Chip Peripheral1|||||Specifies whether the DAC output is connected or not to on chip peripheral.
DAC_SampleAndHold|Mode selected|||||Specifies the DAC mode. Only Normal Mode is available.

[Values]
# параметр|значение|подпись
DAC_Channel|DAC_CHANNEL_1|DAC_CHANNEL_1
DAC_Trigger|DAC_TRIGGER_NONE|None
DAC_Trigger|DAC_TRIGGER_SOFTWARE|Software trigger
DAC_Trigger|DAC_TRIGGER_T16_TRGO|Timer 16 Trigger Out event
DAC_Trigger|DAC_TRIGGER_EXT_IT8|External line 8 SYSCFG
DAC_OutputBuffer|DAC_OUTPUTBUFFER_ENABLE|Enable
DAC_OutputBuffer|DAC_OUTPUTBUFFER_DISABLE|Disable
TriangleAmplitude|DAC_TRIANGLEAMPLITUDE_1|1
TriangleAmplitude|DAC_TRIANGLEAMPLITUDE_3|3
TriangleAmplitude|DAC_TRIANGLEAMPLITUDE_7|7
TriangleAmplitude|DAC_TRIANGLEAMPLITUDE_15|15
TriangleAmplitude|DAC_TRIANGLEAMPLITUDE_31|31
TriangleAmplitude|DAC_TRIANGLEAMPLITUDE_63|63
NoiseAmplitude|DAC_LFSRUNMASK_BIT0|Unmask DAC channel LFSR bit0
NoiseAmplitude|DAC_LFSRUNMASK_BITS1_0|Unmask DAC channel LFSR bits[1:0]
NoiseAmplitude|DAC_LFSRUNMASK_BITS2_0|Unmask DAC channel LFSR bits[2:0]
NoiseAmplitude|DAC_LFSRUNMASK_BITS3_0|Unmask DAC channel LFSR bits[3:0]
NoiseAmplitude|DAC_LFSRUNMASK_BITS4_0|Unmask DAC channel LFSR bits[4:0]
NoiseAmplitude|DAC_LFSRUNMASK_BITS5_0|Unmask DAC channel LFSR bits[5:0]
DAC1_ConnectOnChipPeripheral|DAC_CHIPCONNECT_INTERNAL|DAC_CHIPCONNECT_INTERNAL
DAC1_ConnectOnChipPeripheral|DAC_CHIPCONNECT_BOTH|DAC_CHIPCONNECT_BOTH
DAC1_ConnectOnChipPeripheral|DAC_CHIPCONNECT_EXTERNAL|DAC_CHIPCONNECT_EXTERNAL
DAC_SampleAndHold|DAC_SAMPLEANDHOLD_DISABLE|Normal Mode
