# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=SAES
Version=aes3_v2_0_H7RS_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
Algorithm|Data encryption type|Algorithm||||AES Data encryption types list This parameter can be a value of @ref CRYP_Algorithm_Mode Possible values are: CRYP_AES_ECB: Electronic codebook chaining algorithm CRYP_AES_CBC: Cipher block chaining algorithm CRYP_AES_CTR: Counter mode chaining algorithm CRYP_AES_GCM_GMAC: Galois counter mode - Galois message authentication code CRYP_AES_CCM: Counter with Cipher Mode
DataType|Data type|Parameters||||AES/TDES Data Type selection: 32-bit data, 16-bit data, 8-bit data or 1-bit string. This parameter can be a value of @ref CRYP_Data_Type. Possible values are: CRYP_DATATYPE_32B: 32-bit data type (no swapping) CRYP_DATATYPE_16B: 16-bit data type (half-word swapping) CRYP_DATATYPE_8B: 8-bit data type (byte swapping) CRYP_DATATYPE_1B: 1-bit data type (bit swapping)
KeySize|KeySize|Parameters||||Key size selection: 128 or 256 bits. This parameter can be a value of @ref CRYP_Key_Size. Possible values are: CRYP_KEYSIZE_128B: 128-bit long key CRYP_KEYSIZE_256B: 256-bit long key
pKey|Encryption/Decryption key|Parameters||||Encryption/Decryption key
pInitVect|Initialization vector|Parameters||||Initialization Vector used for CTR, CBC,GCM GMAC, CMAC (and CCM when applicable) modes
Header|Header|Parameters||||The header also known as Additional Authentication Data is used for authentication
HeaderInput|Header(Additional Authentication Data)|Parameters||||The header, also known as Additional Authentication Data in GCM mode is used as first part of the message just after the Initial Counter Block (ICB), and precede the plain text message. Input format: hexadecimal (ex: 0123456789abcdef)
HeaderSize|Header size|Parameters||4|4294967295|Header size in word
B0|B0|Parameters||||One 16-byte first authentication block, part of CBC-MAC mode Counter
DataWidthUnit|Data width unit|Parameters||||Payload Data Width Unit This parameter can be value of @ref CRYP_Data_Width_Unit Possible values are: CRYP_DATAWIDTHUNIT_WORD: By default, header size unit is word CRYP_DATAWIDTHUNIT_BYTE: Header size unit is byte
HeaderWidthUnit|Header width unit|Parameters||||Header Width Unit This parameter can be value of @ref CRYP_Header_Width_Unit Possible values are: CRYP_HEADERWIDTHUNIT_WORD: By default, header size unit is word CRYP_HEADERWIDTHUNIT_BYTE: Header size unit is byte
KeyIVConfigSkip|Key and IV configuration skip|Parameters||||CRYP key and IV Configuration Skip Mode: This parameter can be a value of @ref CRYP_Configuration_Skip. Possible values are: CRYP_KEYIVCONFIG_ALWAYS: Peripheral Key and IV configuration to do systematically CRYP_KEYIVCONFIG_ONCE: Peripheral Key and IV configuration to do only once CRYP_KEYNOCONFIG: Peripheral Key configuration to not do
KeyMode|Key mode|Parameters||||CRYP key Mode: This parameter can be a value of @ref CRYP_Key_Mode. Possible values are: CRYP_KEYMODE_NORMAL: Normal key usage, Key registers are freely useable CRYP_KEYMODE_WRAPPED: Wrapped key, to encrypt or decrypt AES keys It is strongly recommended to select the DHUK when KMOD[1:0] is 01, by setting KEYSEL[2:0] to 001 or 100. CRYP_KEYMODE_SHARED: Shared key It is strongly recommended to select the DHUK when KMOD[1:0] = 10, by setting KEYSEL[2:0] to 001 or 100.
KeySelect|Key selection|Parameters||||CRYP key selection: This parameter can be a value of @ref CRYP_Key_Select. Possible values are: CRYP_KEYSEL_NORMAL: Normal key, key registers SAES_KEYx or CRYP_KEYx CRYP_KEYSEL_HW: Hardware key, derived hardware unique key (DHUK 256-bit) CRYP_KEYSEL_SW: Software key, boot hardware key BHK (256-bit) CRYP_KEYSEL_HSW: DHUK XOR BHK Hardware unique key XOR software key

