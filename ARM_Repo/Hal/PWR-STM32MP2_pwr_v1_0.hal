# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=PWR
Version=STM32MP2_pwr_v1_0

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
IOSemaphoreAssignement|IO Semaphore Assignement|||||
Mode|PWR PVD Mode|||||Mode: Specifies the PVD trigger mode.

[Values]
# параметр|значение|подпись
Mode|PWR_PVD_MODE_NORMAL|basic mode is used
Mode|PWR_PVD_MODE_IT_RISING|External Interrupt Mode with Rising edge trigger detection
Mode|PWR_PVD_MODE_IT_FALLING|External Interrupt Mode with Falling edge trigger detection
Mode|PWR_PVD_MODE_IT_RISING_FALLING|External Interrupt Mode with Rising/Falling edge trigger detection
Mode|PWR_PVD_MODE_EVENT_FALLING|Event Mode with Falling edge trigger detection
