# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=RNG
Version=rng1_v3_1

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
ClockErrorDetection|Clock Error Detection|||||
BypassMode|Bypass mode|||||

[Values]
# параметр|значение|подпись
ClockErrorDetection|RNG_CED_ENABLE|Enable
ClockErrorDetection|RNG_CED_DISABLE|Disable
BypassMode|RNG_BYP_DISABLE|Disable
BypassMode|RNG_BYP_ENABLE|Enable
