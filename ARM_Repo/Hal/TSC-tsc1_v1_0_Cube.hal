# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=TSC
Version=tsc1_v1_0_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
CTPulseHighLength|Charge Transfer High Pulse Length|TSC Settings||||Charge Transfer High Pulse Length
CTPulseLowLength|Charge Transfer Low Pulse Length|TSC Settings||||Charge Transfer Low Pulse Length
SpreadSpectrum|Spread Spectrum|TSC Settings||||Spread Spectrum activation
SpreadSpectrumDeviation|Spread Spectrum Deviation|TSC Settings||1|128|
SpreadSpectrumPrescaler|Spread Spectrum Prescaler|TSC Settings||||
PulseGeneratorPrescaler|Pulse Generator Prescaler|TSC Settings||||Pulse Generator Prescaler
MaxCountValue|Maximum Count Value|TSC Settings||||Maximum Count Value
IODefaultMode|IO Default Mode|TSC Settings||||IO Default Mode describe if the IO are forced to output pushpull low or are in input floating
SynchroPinPolarity|Synchro Pin Polarity|TSC Settings||||
AcquisitionMode|Acquisition Mode|TSC Settings||||Aquisition mode can be : Normal acquisition mode (acquisition starts as soon as START bit is set) or Synchronized acquisition mode (acquisition starts if START bit is set and when the selected signal is detected on the SYNC input pin
MaxCountInterrupt|Maximum Count Interrupt|TSC Settings||||Maximum Count Interrupt activation
ChannelIOs|Channel IOs|TSC Settings||||
ShieldIOs|Shield IOs|TSC Settings||||
SamplingIOs|Sampling IOs|TSC Settings||||
Gx_IOx-Sampling|Gx_IOx-Sampling|TSC Settings||0|8|
Gx_IOx-Channel|Gx_IOx-Channel|TSC Settings||0|24|
Gx_IOx-Shield|Gx_IOx-Shield|TSC Settings||0|8|
TSC_G4_IO1|TSC G4 IO1|||||
TSC_G6_IO1|TSC G6 IO1|||||
TSC_G7_IO2|TSC G7 IO2|||||
TSC_G2_IO1|TSC G2 IO1|||||
TSC_G2_IO3|TSC G2 IO3|||||

