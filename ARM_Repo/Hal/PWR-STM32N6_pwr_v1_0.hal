[Ip]
Name=PWR
Version=STM32N6_pwr_v1_0

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
PVDLevel|PVD detection Level|||||
Mode|PWR PVD Mode|||||Mode: Specifies the PVD trigger mode.
AVDLevel|AVD detection Level|||||
AVDMode|PWR AVD Mode|||||Mode: Specifies the PVD trigger mode.
pwrPrivilegeSecure|Privilege of PWR Secure Items|Privilege PWR||||
pwrPrivilegeNSecure|Privilege of PWR Non-Secure Items|Privilege PWR||||
pwrPrivilege|PWR Privilege|Privilege PWR||||
pwrSecureFull|PWR full secure|Secure PWR||||
PWR_WKUP1|Wake-Up 1 secure protection|Secure PWR||||
PWR_WKUP2|Wake-Up 2 secure protection|Secure PWR||||
PWR_WKUP3|Wake-Up 3 secure protection|Secure PWR||||
PWR_WKUP4|Wake-Up 4 secure protection|Secure PWR||||
PWR_VDM|Voltage detection and monitoring secure protection|Secure PWR||||
PWR_LPM|Low power modes secure protection|Secure PWR||||
PWR_VB|Backup domain secure protection|Secure PWR||||
PWR_IO|Retention secure protection|Secure PWR||||
PWR_SCM|Supply configuration and monitoring secure protection|Secure PWR||||
PWR_VUSB|Voltage USB Secure Protection|Secure PWR||||
PWR_APC|Pull-up/pull-down secure protection|Secure PWR||||
HighImpedanceMode|High impedance mode|||||
VoltageScaling|Internal Voltage reference scale|||||
TrimmingMode|Trimming Mode|||||
DisableDeadBatterySignalsConfig|UCPD Disable Dead Battery Signals|||||
TrimmingValue|Trimming Value|||0|63|
PowerDomain2|VDDIO2||V|||To activate the VDDIO2 domain, try using PO[5:0] or PP[15:0].
PowerDomain3|VDDIO3||V|||To activate the VDDIO3 domain, try using PN[12:0].
PowerDomain4|VDDIO4||V|||To activate the VDDIO4 domain, try using PC[1], PC[12:6] or PH[9,2].
PowerDomain5|VDDIO5||V|||To activate the VDDIO5 domain, try using PC[0], PC[5:2] or PE[4].

