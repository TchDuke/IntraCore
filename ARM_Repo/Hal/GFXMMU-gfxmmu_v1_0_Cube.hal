# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=GFXMMU
Version=gfxmmu_v1_0_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
BlocksPerLine|Number of blocks of 16 bytes per line|||||Number of blocks of 16 bytes per line Then if the pixel is coded on - 16bpp with 192 blocks per line the resolution is 1536x1024 - 32bpp with 192 blocks per line the resolution is 768x1024 - 24bpp with 192 blocks per line the resolution is 1024x1024 - 16bpp with 256 blocks per line the resolution is 2048x1024 - 32bpp with 256 blocks per line the resolution is 1024x1024 - 24bpp with 256 blocks per line is not allowed as the number of pixel is not an integer When - LTDC Layer is configured to 24bpp Or - BitPerPixel(BPP) is defined as 24bpp (see LUT Configuration Table) Then - Only 192 blocs per line is possible (256 blocks per line is not allowed as the number of pixel is not an integer)
BlockSize|Block Size|||||Size of virtual memory block
AddressTranslation|Address translation|||||Address translation. Activate it to specify the configuration details
DefaultValue|Default Value|||0|0xFFFFFFFF|Value returned when virtual memory location not physically mapped.
Buf0Address|Physical address of buffer 0|||0|0xFFFFFFFF|
Buf1Address|Physical address of buffer 1|||0|0xFFFFFFFF|
Buf2Address|Physical address of buffer 2|||0|0xFFFFFFFF|
Buf3Address|Physical address of buffer 3|||0|0xFFFFFFFF|
ITActivation|Interrupts activation|||||
GFXMMU_AHB_MASTER_ERROR_IT|AHB master error interrupt|||||
GFXMMU_BUS_MASTER_ERROR_IT|BUS master error interrupt|||||
GFXMMU_BUFFER0_OVERFLOW_IT|Buffer 0 overflow interrupt|||||
GFXMMU_BUFFER1_OVERFLOW_IT|Buffer 1 overflow interrupt|||||
GFXMMU_BUFFER2_OVERFLOW_IT|Buffer 2 overflow interrupt|||||
GFXMMU_BUFFER3_OVERFLOW_IT|Buffer 3 overflow interrupt|||||
CacheActivation|Cache and Prefetch Activation|||||Cache and Prefetch activation. Activate it to specify the configuration details
CacheLock|Cache Lock|||||Locking the cache to a specific buffer (defined by the Cache Lock Buffer parameter)
CacheLockBuffer|Cache Lock Buffer|||||Buffer on which the cache is locked. Note: Useful only when Cache Lock parameter is enabled.
CacheForce|Cache Force|||||Forcing the cache regardless MPU attributes
OutterBufferability|OutterBufferability|||||Bufferability of an access generated by the GFXMMU cache.
OutterCachability|OutterCachability|||||Cachability of an access generated by the GFXMMU cache
Prefetch|Prefetch|||||Pre-fetch enable/disable
AddressCacheActivation|Address Cache|||||Address Cache activation. Activate it to specify the configuration details
AddressCacheLockBuffer|Adress Cache Lock Buffer|||||Buffer on which the cache is locked. Note: Useful only when Address Cache Lock parameter is enabled.
UsedInterruptsARG|Periph Clock Selection|||||
ErrorItVar|ErrorItVar|||||
Buffer0Var|Buffer0Var|||||
Buffer1Var|Buffer1Var|||||
Buffer2Var|Buffer2Var|||||
Buffer3Var|Buffer3Var|||||
UsedInterrupts|Interrupts used|||||
UsedActivationARG|Periph Clock Selection|||||
CacheLockItVar|CacheLockItVar|||||
CacheLockBufferVar|CacheLockBufferVar|||||
CacheForceVar|CacheForceVar|||||
OutterBufferabilityVar|OutterBufferabilityVar|||||
OutterCachabilityVar|OutterCachabilityVar|||||
PrefetchVar|PrefetchVar|||||
UsedActivation|Activation used|Cache and prefetch enabling||||
Buffer0Activation|Activation Buffer0|Packing||||
Buffer0Mode|Mode Buffer0|Packing||||
Buffer1Activation|Activation Buffer1|Packing||||
Buffer1Mode|Mode Buffer1|Packing||||
Buffer2Activation|Activation Buffer2|Packing||||
Buffer2Mode|Mode Buffer2|Packing||||
Buffer3Activation|Activation Buffer3|Packing||||
Buffer3Mode|Mode Buffer3|Packing||||
DefaultAlpha|Default Alpha|Packing||0|255|
GFXMMUtable|GFXMMU save Table|||||
BPP|BPP|||1|3|

