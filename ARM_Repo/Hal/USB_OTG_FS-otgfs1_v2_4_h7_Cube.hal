# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=USB_OTG_FS
Version=otgfs1_v2_4_h7_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
dev_endpoints|Device endpoints number|||1|9|
Host_channels|Host Channels|||1|16|
VirtualMode||Basic Parameters||||
speed_host|Speed|Host||||
speed|Speed|||||
DeviceSpeed|Speed|Device||||
dma_enable|Enable internal IP DMA|Device||||
dma_enable_host|Enable internal IP DMA|Host||||
ep0_mps|Endpoint 0 Max Packet size|||||
phy_itface|Physical interface|Device||||
phy_itface_host|Physical interface|Host||||
Sof_enable|Signal start of frame|Device||||
Sof_enable_host|Signal start of frame|Host||||
lpm_enable|Link Power Management|Device||||
low_power_enable|Low power|Device||||
battery_charging_enable|Battery charging|||||
vbus_sensing_enable|VBUS sensing|Device||||
use_dedicated_ep1|Use dedicated end point 1 interrupt|Device||||
use_external_vbus|Use external vbus|||||

[Values]
# параметр|значение|подпись
VirtualMode|Host_Only|
VirtualMode|Device_Only|
VirtualMode|Dual_Role_Device_FS|
speed_host|HCD_SPEED_FULL|Full Speed 12MBit/s
speed_host|HCD_SPEED_LOW|Low Speed 1.5MBit/s
speed|HCD_SPEED_FULL|Full Speed 12MBit/s
speed|HCD_SPEED_LOW|Low Speed 1.5MBit/s
DeviceSpeed|PCD_SPEED_FULL|Full Speed 12MBit/s
DeviceSpeed|PCD_SPEED_LOW|Low Speed 1.5MBit/s
ep0_mps|DEP0CTL_MPS_64|64 Bytes
ep0_mps|DEP0CTL_MPS_32|32 Bytes
ep0_mps|DEP0CTL_MPS_16|16 Bytes
ep0_mps|DEP0CTL_MPS_8|8 Bytes
phy_itface|PCD_PHY_EMBEDDED|Internal Phy
phy_itface_host|HCD_PHY_EMBEDDED|Internal Phy
