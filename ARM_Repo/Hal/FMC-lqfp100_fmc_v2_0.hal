# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=FMC
Version=lqfp100_fmc_v2_0

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
NORSRAM_Instance|Device|||||
Extended|Extended Device|||||
NSCoherentPinout1|NS Coherent Pinout|NOR/PSRAM control||||
NSBank1|Bank|NOR/PSRAM control||||
DataAddressMux1|Data address multiplexing|NOR/PSRAM control||||
MemoryType1|Memory type|NOR/PSRAM control||||
NSMemoryDataWidth1|Data size|NOR/PSRAM control||||
BurstAccessMode1|Burst read|NOR/PSRAM control||||
WaitSignalPolarity1|Wait signal polarity|NOR/PSRAM control||||
WaitSignalActive1|Wait timing configuration|NOR/PSRAM control||||
WriteOperation1|Write operation|NOR/PSRAM control||||
WaitSignal1|Wait state insertion|NOR/PSRAM control||||
ExtendedMode1|Extended mode|NOR/PSRAM control||||
AsynchronousWait1|Asynchronous wait|NOR/PSRAM control||||
WriteBurst1|Burst write|NOR/PSRAM control||||
ContinuousClock1|NOR/PSRAM common continuous clock|NOR/PSRAM control||||There is only one continuous clock enable bit located in sub-bank Bank 1 - NOR/PSRAM 1.
WriteFifo1|Write FIFO|NOR/PSRAM control||||Enables or disables the write FIFO used by the FMC controller.
PageSize1|CRAM page size|NOR/PSRAM control||||For Cellular RAM 1.5, specifies the memory page size from which a burst access is split.
AddressSetupTime1|Address setup time in FMC clock cycles|NOR/PSRAM timing||0|15|
AddressHoldTime1|Address hold time in FMC clock cycles|NOR/PSRAM timing||1|15|
DataSetupTime1|Data setup time in FMC clock cycles|NOR/PSRAM timing||1|255|
BusTurnAroundDuration1|Bus turn around time in FMC clock cycles|NOR/PSRAM timing||0|15|
CLKDivision1|CLK clock divide ratio|NOR/PSRAM timing||2|16|
DataLatency1|Data latency in CLK clock cycles|NOR/PSRAM timing||2|17|
AccessMode1|Access mode|NOR/PSRAM timing||||
ExtendedAddressSetupTime1|Extended address setup time|NOR/PSRAM timing for write accesses||0|15|
ExtendedAddressHoldTime1|Extended address hold time|NOR/PSRAM timing for write accesses||1|15|
ExtendedDataSetupTime1|Extended data setup time|NOR/PSRAM timing for write accesses||1|255|
ExtendedBusTurnAroundDuration1|Extended bus turn around time|NOR/PSRAM timing for write accesses||0|15|
ExtendedCLKDivision1|Extended CLK clock divide ratio|NOR/PSRAM timing for write accesses||||
ExtendedDataLatency1|Extended data latency|NOR/PSRAM timing for write accesses||||
ExtendedAccessMode1|Extended access mode|NOR/PSRAM timing for write accesses||||

