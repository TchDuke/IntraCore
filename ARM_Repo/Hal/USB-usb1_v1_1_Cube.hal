# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=USB
Version=usb1_v1_1_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
DeviceSpeed|Speed|Basic Parameters||||
dev_endpoints|Device endpoints number|||1|8|
ep0_mps|Endpoint 0 Max Packet size|Basic Parameters||8|64|
phy_itface|Physical interface|Basic Parameters||||
Sof_enable|Sof Enable|Basic Parameters||||
low_power_enable|Low Power|Power Parameters||||This mode is not supproted on CubeMx V4.2
lpm_enable|Link Power Management|Power Parameters||||
battery_charging_enable|Battery Charging|Power Parameters||||

[Values]
# параметр|значение|подпись
DeviceSpeed|PCD_SPEED_FULL|Full Speed 12MBit/s
ep0_mps|DEP0CTL_MPS_64|64 Bytes
ep0_mps|DEP0CTL_MPS_32|32 Bytes
ep0_mps|DEP0CTL_MPS_16|16 Bytes
ep0_mps|DEP0CTL_MPS_8|8 Bytes
phy_itface|PCD_PHY_EMBEDDED|Internal Phy
