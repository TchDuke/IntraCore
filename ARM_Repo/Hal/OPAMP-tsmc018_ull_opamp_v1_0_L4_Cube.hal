[Ip]
Name=OPAMP
Version=tsmc018_ull_opamp_v1_0_L4_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
PowerSupplyRange|Power Supply Range|Basic Parameters||||OPAMP_POWERSUPPLY_HIGH is the only available choice in STM32U5.
PowerMode|Power Mode and Speed|Basic Parameters||||
NonInvertingInput|Non Inverting Input|Basic Parameters||||
InvertingInput|Inverting Input|Basic Parameters||||
InternalOutput|Internal Output|Basic Parameters||||
PgaGain|PGA Gain|Basic Parameters||||
UserTrimming|User Trimming|Basic Parameters||||
SelfCalibration|Self Calibration|Basic Parameters||||Self Calibration is not available for LL configuration.
TrimmingValueP|OffSet Trimming Value (PMOS)|Basic Parameters||0|31|
TrimmingValueN|OffSet Trimming Value (NMOS)|Basic Parameters||0|31|
TrimmingValuePLowPower|OffSet Trimming Value Low Power (PMOS)|Basic Parameters||0|31|
TrimmingValueNLowPower|OffSet Trimming Value Low Power (NMOS)|Basic Parameters||0|31|
Mode|Mode|Basic Parameters||||

