# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=NVIC
Version=STM32L462

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
PriorityGroup|Priority Group|||||
PreemptionPriority|Preemption Priority|||0|15|
SubPriority|Sub Priority|||0|0|
IRQn|Interrupt Table|||||

[Values]
# параметр|значение|подпись
PriorityGroup|NVIC_PRIORITYGROUP_4|4 bits for pre-emption priority 0 bits for subpriority
PriorityGroup|NVIC_PRIORITYGROUP_0|0 bits for pre-emption priority 4 bits for subpriority
PriorityGroup|NVIC_PRIORITYGROUP_1|1 bits for pre-emption priority 3 bits for subpriority
PriorityGroup|NVIC_PRIORITYGROUP_2|2 bits for pre-emption priority 2 bits for subpriority
PriorityGroup|NVIC_PRIORITYGROUP_3|3 bits for pre-emption priority 1 bits for subpriority
