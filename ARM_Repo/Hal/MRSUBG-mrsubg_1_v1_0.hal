# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=MRSUBG
Version=mrsubg_1_v1_0

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
lFrequencyBase|lFrequencyBase|Radio||0||the base carrier frequency.
xModulationSelect|xModulationSelect|Radio||||Specifies the modulation.
lDatarate|lDatarate|Radio||0||the datarate expressed in sps.
lFreqDev|lFreqDev|Radio||0||the frequency deviation.
lBandwidth|lBandwidth|Radio||0||the channel filter bandwidth.
dsssExp|dsssExp|Radio||0|255|the DSSS spreading exponent.
outputPower|outputPower|Radio||0x0|0xFF|
PADrvMode|PADrvMode|Radio||||drive modes.In case Sigfox is activated, then PA_DRV_TX is forbidden
PacketFormat|Packet Format|Packet||||Packet Format.
xWMbusSubmode|xWMbusSubmode|Packet||||WMBUS submode
PreambleLength|PreambleLength|Packet||4|64|the preamble length of packet. From 1 to 2046 bit.
PostambleLength|PostambleLength|Packet||0|63|the postable length of packet. From 1 to 63 bit.
SyncLength|SyncLength|Packet||0|64|the sync word length of packet in bits. From 1 to 64 bits.
SyncWord|SyncWord|Packet||0x0|0xFFFFFFFF|the sync words in MSB.
FixVarLength|FixVarLength|Packet||||
PreambleSequence|PreambleSequence|Packet||||
PostambleSequence|PostambleSequence|Packet||||Packet postamble control: postamble bit sequence selection.
CrcMode|CrcMode|Packet||||the CRC type
Coding|Coding|Packet||||
DataWhitening|DataWhitening|Packet||||the data whitening.
LengthWidth|LengthWidth|Packet||||
SyncPresent|SyncPresent|Packet||||
Modulation|Modulation|Packet||||Modulation
FCSType|FCSType|Packet||||the FCS type
Whitening|Whitening|Packet||||the data whitening.
FecType|FecType|Packet||||FEC type for 802.15.4g
FrameLength|FrameLength|Packet||0|65535|Frame Length

