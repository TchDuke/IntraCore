# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=DAC
Version=G4_dacif_v4_0_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
DAC_Channel|Channel|||||
DAC_Trigger_OUT1|Trigger|||||Specifies the external trigger for the selected DAC channel.
DAC_Trigger_OUT2|Trigger|||||Specifies the external trigger for the selected DAC channel.
DAC_Trigger2_OUT1|Trigger2|||||Specifies the external trigger for the selected DAC channel.
DAC_Trigger2_OUT2|Trigger2|||||Specifies the external trigger for the selected DAC channel.
DAC_OutputBuffer|Output Buffer|||||
TriangleAmplitude_OUT1|Triangle Amplitude|||||
TriangleAmplitude_OUT2|Triangle Amplitude|||||
DAC_HighFrequency_OUT1|DAC High Frequency|||||
DAC_HighFrequency_OUT2|DAC High Frequency|||||
NoiseAmplitude_OUT1|Noise Amplitude|||||
NoiseAmplitude_OUT2|Noise Amplitude|||||
WaveGeneration_OUT1|Wave generation mode|||||
WaveGeneration_OUT2|Wave generation mode|||||
DAC_DMADoubleDataMode|DMA Double Data|||||Specifies if DMA double data mode should be enabled or not for the selected channel.
DAC_SignedFormat|Signed Format|||||Specifies if signed format should be used or not for the selected channel.
PolaritySawtooth|Polarity|||||Polarity to be used for wave generation.
PolaritySawtooth2|Polarity|||||Polarity to be used for wave generation.
ResetDataSawtooth|Reset Data|||0|4095|Specifies the ResetData Sawtooth wave reset value.
ResetDataSawtooth2|Reset Data|||0|4095|Specifies the ResetData Sawtooth wave reset value.
StepDataSawtooth|Step Data|||0|4095.9375|Specifies the StepData Sawtooth wave step value.
StepDataSawtooth2|Step Data|||0|4095.9375|Specifies the StepData Sawtooth wave step value.
DAC_ConnectOnChipPeripheral1|Connect On Chip Peripheral1|||||Specifies whether the DAC output is connected or not to on chip peripheral .
DAC_ConnectOnChipPeripheral2|Connect On Chip Peripheral2|||||Specifies whether the DAC output is connected or not to on chip peripheral .
DAC_UserTrimming|User Trimming|||||Specifies the trimming mode This parameter must be a value of DAC User Trimming DAC_UserTrimming is either factory or user trimming
DAC_TrimmingValue|Trimming Value|||1|31|Specifies the offset trimming value i.
DAC_SampleAndHold|Mode selected|||||Specifies whether the DAC mode.
DAC_SampleTime|Sample Time|||0|1023|Specifies the Sample time for the selected channel.
DAC_HoldTime|Hold Time|||0|1023|Specifies the hold time for the selected channel This parameter applies when DAC_SampleAndHold is DAC_SAMPLEANDHOLD_ENABLE.
DAC_RefreshTime|Refresh Time|||0|255|Specifies the refresh time for the selected channel This parameter applies when DAC_SampleAndHold is DAC_SAMPLEANDHOLD_ENABLE.

