# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=COMP
Version=advsmu_v3_6_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
InvertingInput|Inverting Input|Pinout Parameters||||Selects the Inverting Input of the Comparator.
NonInvertingInput|Non-Inverting Input|Pinout Parameters||||Selects the Non-Inverting Input of the Comparator.
WindowMode|Window Mode|Pinout Parameters||||
Mode|Speed Mode|Basic Parameters||||Selects the operating Consumption Mode of the Comparator to adjust the Speed/Consumption.
TriggerMode|Interrupt Trigger Mode|Basic Parameters||||Selects the Trigger Mode of the Comparator when using Interruption on EXTI line (Interrupt Mode).
NonInvertingInputPull|Non-Inverting Internal Resistor|Basic Parameters||||Selects the internal pulling resistor connected on Non-Inverting Input.
Output|Output Internal Selection|Output Parameters||||Selects the output redirection of the comparator.

[Values]
# параметр|значение|подпись
