# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=USB_OTG_FS
Version=otgfs1_v3_0_H5_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
VirtualMode||Basic Parameters||||
dev_endpoints|Device endpoints number|||1|6|
Host_channels|Host Channels|||1|12|
DeviceSpeed|Speed|Device configuration||||
speed_host|Speed|Host configuration||||
dma_enable|Enable internal IP DMA|||||
ep0_mps|Endpoint 0 Max Packet size|||||
phy_itface|Physical interface|||||
Sof_enable_host|Signal start of frame|Host configuration||||
Sof_enable|Signal start of frame|Device configuration||||
lpm_enable|Link Power Management|Device configuration||||
low_power_enable|Low power|Device configuration||||
battery_charging_enable|Battery charging|Device configuration||||
vbus_sensing_enable|VBUS sensing|Device configuration||||
use_dedicated_ep1|Use dedicated end point 1 interrupt|Device configuration||||

[Values]
# параметр|значение|подпись
VirtualMode|Host_Only|
VirtualMode|Device_Only|
VirtualMode|Dual_Role_Device_FS|
DeviceSpeed|USB_OTG_SPEED_HIGH|High Speed 480MBit/s
DeviceSpeed|USB_OTG_SPEED_HIGH_IN_FULL|Hich Full Speed 12MBit/s
DeviceSpeed|USB_OTG_SPEED_FULL|Full Speed 1.5MBit/s
speed_host|USB_OTG_SPEED_HIGH|High Speed 480MBit/s
speed_host|USB_OTG_SPEED_HIGH_IN_FULL|High Full Speed 12MBit/s
speed_host|USB_OTG_SPEED_FULL|Full Speed 1.5MBit/s
ep0_mps|DEP0CTL_MPS_64|64 Bytes
ep0_mps|DEP0CTL_MPS_32|32 Bytes
ep0_mps|DEP0CTL_MPS_16|16 Bytes
ep0_mps|DEP0CTL_MPS_8|8 Bytes
phy_itface|PCD_PHY_EMBEDDED|Internal Phy
phy_itface|HCD_PHY_EMBEDDED|Internal Phy
