# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=AES
Version=aes2_v1_1_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
Data encryption types list|Data encryption type|Algorithm||||AES Data encryption types list
DataType|Data type|Parameters||||AES Data Type selection: 32-bit data, 16-bit data, 8-bit data or 1-bit string. This parameter can be a value of @ref CRYP_Data_Type. Possible values are: CRYP_DATATYPE_32B: 32-bit data type (no swapping) CRYP_DATATYPE_16B: 16-bit data type (half-word swapping) CRYP_DATATYPE_8B: 8-bit data type (byte swapping) CRYP_DATATYPE_1B: 1-bit data type (bit swapping)
KeySize|KeySize|Parameters||||Key size selection: 128 or 256 bit key length. This parameter can be a value of @ref CRYP_Key_Size. Possible values are: CRYP_KEYSIZE_128B CRYP_KEYSIZE_256B
OperatingMode|Operating Mode|Parameters||||AES ECB/CBC operating mode. This parameter can be a value of @ref CRYP_AES_OperatingMode. Possible values are: CRYP_ALGOMODE_ENCRYPT CRYP_ALGOMODE_KEYDERIVATION CRYP_ALGOMODE_DECRYPT CRYP_ALGOMODE_KEYDERIVATION_DECRYPT
ChainingMode|Chaining Mode|Parameters||||AESECB Chaining Mode. This parameter can be a value of @ref CRYP_AES_ChainingMode Possible values are: CRYP_CHAINMODE_AES_ECB
KeyWriteFlag|Key Write Flag|Parameters||||Key Write Flag. This parameter allows to bypass or not key write-up before decryption. It can be a value of @ref CRYP_Key_Write Possible values are: CRYP_KEY_WRITE_ENABLE CRYP_KEY_WRITE_DISABLE
GCMCMACPhase|GCM Phase (Processing phase of the Galois Counter Mode)|Parameters||||Indicates the processing phase of the Galois Counter Mode (GCM), Galois Message Authentication Code (GMAC), Cipher Message Authentication Code (CMAC) (when applicable) or Counter with Cipher Mode (CCM) (when applicable).This parameter can be a value of @ref CRYP_GCM_CMAC_Phase
pKey|Encryption/Decryption key|Parameters||||Encryption/Decryption key
pInitVect|Initialization vector|Parameters||||Initialization Vector used for CTR, CBC,GCM GMAC, CMAC (and CCM when applicable) modes
Header|Header|Parameters||||Header used in GCM GMAC, CMAC
HeaderSize|Header size|Parameters||||Header size in bytes

[Values]
# параметр|значение|подпись
DataType|CRYP_DATATYPE_32B|32b(no swapping)
DataType|CRYP_DATATYPE_16B|16b(half-word swapping)
DataType|CRYP_DATATYPE_8B|8b(byte swapping)
DataType|CRYP_DATATYPE_1B|1b(bit swapping)
KeySize|CRYP_KEYSIZE_128B|128b
KeySize|CRYP_KEYSIZE_256B|256b
OperatingMode|CRYP_ALGOMODE_ENCRYPT|Encryption mode
OperatingMode|CRYP_ALGOMODE_KEYDERIVATION|Key derivation mode
OperatingMode|CRYP_ALGOMODE_DECRYPT|Decryption
OperatingMode|CRYP_ALGOMODE_KEYDERIVATION_DECRYPT|Key derivation and decryption
OperatingMode|CRYP_ALGOMODE_TAG_GENERATION|GMAC authentication tag generation
ChainingMode|CRYP_CHAINMODE_AES_ECB|Electronic codebook chaining algorithm(CRYP_CHAINMODE_AES_ECB)
ChainingMode|CRYP_CHAINMODE_AES_CBC|Cipher block chaining algorithm (CRYP_CHAINMODE_AES_CBC)
ChainingMode|CRYP_CHAINMODE_AES_CTR|Counter mode chaining algorithm (CRYP_CHAINMODE_AES_CTR)
ChainingMode|CRYP_CHAINMODE_AES_GCM_GMAC|Galois counter mode - Galois message authentication code (CRYP_CHAINMODE_AES_GCM_GMAC)
ChainingMode|CRYP_CHAINMODE_AES_CMAC|Cipher message authentication code (CRYP_CHAINMODE_AES_CMAC)
KeyWriteFlag|CRYP_KEY_WRITE_ENABLE|Enable decryption key writing
KeyWriteFlag|CRYP_KEY_WRITE_DISABLE|Disable decryption key writing
GCMCMACPhase|CRYP_GCM_INIT_PHASE|GCM GMAC init phase
GCMCMACPhase|CRYP_GCMCMAC_HEADER_PHASE|GCM GMAC header phase
GCMCMACPhase|CRYP_GCM_PAYLOAD_PHASE|GCM payload phase
GCMCMACPhase|CRYP_GCMCMAC_FINAL_PHASE|GCM GMAC final phase
