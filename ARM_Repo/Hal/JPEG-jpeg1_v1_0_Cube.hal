# IntraCore: параметры HAL блока из базы STM32CubeMX (db/mcu/IP/*_Modes.xml).
# Порождено tools/hal_import — руками не править. Формат: src/Docs/Description/HalCatalogFormat.md
[Ip]
Name=JPEG
Version=jpeg1_v1_0_Cube

[Parameters]
# имя|подпись|группа|единица|мин|макс|описание
JPEG_version|JPEG version|Version||||
ColorSpace|ColorSpace|JPEG basic settings||||Image Color Space : gray_scale, YCBCR, RGB or CMYK
ChromaSubSampling|ChromaSubSampling|JPEG basic settings||||Chroma SubSampling is Non Applicable in case of in case of gray_scale or RGB Color Space.
ImageQuality|ImageQuality|JPEG basic settings||1|100|Quality of the JPEG encoding from 1 to 100
USE_JPEG_ENCODER|ENCODE|JPEG Software options||||This parameter specifies if Encode is acticated
USE_JPEG_DECODER|DECODE|JPEG Software options||||This parameter specifies if Decode is acticated
JPEG_RGB_FORMAT|RGB_FORMAT|JPEG Software options||||Default Value : JPEG_ARGB8888
JPEG_SWAP|JPEG_SWAP|JPEG Software options||||Change color order to BGR, Default Value : 0
JPEG_SWAP_RG|JPEG_SWAP_RG|JPEG Software options||||Change color order to BGR, Default Value : 0

[Values]
# параметр|значение|подпись
JPEG_RGB_FORMAT|JPEG_ARGB8888|JPEG_ARGB8888
JPEG_RGB_FORMAT|JPEG_RGB888|JPEG_RGB888
JPEG_RGB_FORMAT|JPEG_RGB565|JPEG_RGB565
