5|Power|VDDA||
6|I/O|PA5||ADC4_IN4 PWR_CSLEEP:0 PWR_WKUP6 SPI3_NSS:6 TIM2_CH1:1 TIM2_ETR:2 TSC_G1_IO4:9 USART1_CK:7 GPIO
7|I/O|PA2||ADC4_IN7 LPUART1_TX:8 PWR_WKUP4 RCC_LSCO TIM16_CH1:14 TIM1_BKIN:1 TSC_G4_IO4:9 USART1_DE:7 USART1_RTS:7 GPIO
8|I/O|PA1||ADC4_IN8 LPUART1_RX:8 PWR_WKUP3 TIM1_CH1N:1 TSC_G2_IO1:9 USART1_CK:7 GPIO
9|I/O|PA0||ADC4_IN9 LPTIM1_IN1:0 LPUART1_CTS:8 PWR_WKUP1 SPI3_SCK:6 TIM1_CH2N:1 TSC_G2_IO2:9 GPIO
10|I/O|PB9||ADC4_IN10 LPUART1_DE:8 LPUART1_RTS:8 PWR_WKUP8 SPI3_MISO:6 TIM16_CH1:14 TIM1_CH3N:1 TSC_G2_IO3:9 GPIO
11|I/O|PB8||LPTIM1_ETR:0 PWR_PVD_IN SPI3_MOSI:6 TIM16_CH1N:14 TIM1_CH1:1 TSC_G2_IO4:9 GPIO
12|I/O|PC15-OSC32_OUT||ADC4_EXTI15 RCC_OSC32_OUT GPIO
13|I/O|PC14-OSC32_IN||RCC_OSC32_IN GPIO
14|Power|VDD||
15|I/O|PB4 (NJTRST)||DEBUG_NJTRST:0 TIM1_CH3:1 TSC_G3_IO1:9 GPIO
16|I/O|PB3 (JTDO/TRACESWO)||DEBUG_JTDO-SWO:0 LPTIM1_IN2:2 TIM1_CH4:1 TSC_G3_IO2:9 GPIO
17|I/O|PA15 (JTDI)||ADC4_EXTI15 DEBUG_JTDI:0 LPTIM1_CH2:2 TIM1_ETR:1 TSC_G3_IO3:9 GPIO
18|I/O|PA14 (JTCK/SWCLK)||DEBUG_JTCK-SWCLK:0 TAMP_IN3 TAMP_OUT6 GPIO
19|I/O|PA13 (JTMS/SWDIO)||DEBUG_JTMS-SWDIO:0 GPIO
20|I/O|PA12||PWR_WKUP6 TIM1_CH2:1 TSC_G3_IO4:9 GPIO
