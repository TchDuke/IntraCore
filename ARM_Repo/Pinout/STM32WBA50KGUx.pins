# STM32WBA50KGUx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WBA50KGUx
Rpn=STM32WBA50KG
CmsisDevice=
Family=STM32WBA
Line=STM32WBAx0
ClockTree=STM32WBA
Package=UFQFPN32
Core=Arm Cortex-M33
FrequencyMHz=0
Ram=65536
Flash=1048576
IoCount=20
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|I/O|PB12||TIM2_CH1:1 TIM2_ETR:2 TSC_SYNC:9 USART1_TX:7 GPIO
2|I/O|PA8||ADC4_IN1 LPTIM1_CH2:2 RCC_MCO:0 SPI3_RDY:6 TIM2_CH2:1 TSC_G1_IO1:9 USART1_RX:7 GPIO
3|I/O|PA7||ADC4_IN2 I2C3_SDA:4 PWR_WKUP8 TAMP_IN1 TAMP_OUT2 TIM2_CH3:1 TSC_G1_IO2:9 USART1_CTS:7 GPIO
