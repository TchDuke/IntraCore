# STM32F410CBTx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F410CBTx
Rpn=STM32F410CB
CmsisDevice=STM32F410Cx
Family=STM32F4
Line=STM32F410
ClockTree=STM32F410
Package=LQFP48
Core=Arm Cortex-M4
FrequencyMHz=100
Ram=32768
Flash=131072
IoCount=35
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|Power|VBAT||
2|I/O|PC13-ANTI_TAMP||RTC_AF1 GPIO
3|I/O|PC14-OSC32_IN||RCC_OSC32_IN GPIO
4|I/O|PC15-OSC32_OUT||ADC1_EXTI15 RCC_OSC32_OUT GPIO
5|I/O|PH0 - OSC_IN||RCC_OSC_IN GPIO
6|I/O|PH1 - OSC_OUT||RCC_OSC_OUT GPIO
7|Reset|NRST||
8|Power|VSSA/VREF-||
9|Power|VDDA/VREF+||
10|I/O|PA0-WKUP||ADC1_IN0 SYS_WKUP1 TIM5_CH1:2 USART2_CTS:7 GPIO
11|I/O|PA1||ADC1_IN1 TIM5_CH2:2 USART2_RTS:7 GPIO
12|I/O|PA2||ADC1_IN2 I2S_CKIN:5 TIM5_CH3:2 TIM9_CH1:3 USART2_TX:7 GPIO
13|I/O|PA3||ADC1_IN3 I2S2_MCK:5 TIM5_CH4:2 TIM9_CH2:3 USART2_RX:7 GPIO
14|I/O|PA4||ADC1_IN4 I2S1_WS:5 SPI1_NSS:5 USART2_CK:7 GPIO
15|I/O|PA5||ADC1_IN5 DAC_OUT1 I2S1_CK:5 SPI1_SCK:5 GPIO
16|I/O|PA6||ADC1_IN6 I2S2_MCK:6 SPI1_MISO:5 TIM1_BKIN:1 GPIO
17|I/O|PA7||ADC1_IN7 I2S1_SD:5 SPI1_MOSI:5 TIM1_CH1N:1 GPIO
18|I/O|PB0||ADC1_IN8 I2S5_CK:6 SPI5_SCK:6 TIM1_CH2N:1 GPIO
19|I/O|PB1||ADC1_IN9 I2S5_WS:6 SPI5_NSS:6 TIM1_CH3N:1 GPIO
20|I/O|PB2||LPTIM1_OUT:1 GPIO
21|I/O|PB10||FMPI2C1_SCL:9 I2C2_SCL:4 I2S1_MCK:6 I2S2_CK:5 SPI2_SCK:5 GPIO
22|Power|VCAP1||
23|Power|VSS||
24|Power|VDD||
25|I/O|PB12||I2C2_SMBA:4 I2S2_WS:5 SPI2_NSS:5 TIM1_BKIN:1 TIM5_CH1:2 GPIO
26|I/O|PB13||FMPI2C1_SMBA:4 I2S2_CK:5 SPI2_SCK:5 TIM1_CH1N:1 GPIO
27|I/O|PB14||FMPI2C1_SDA:4 SPI2_MISO:5 TIM1_CH2N:1 GPIO
28|I/O|PB15||ADC1_EXTI15 FMPI2C1_SCL:4 I2S2_SD:5 RTC_REFIN:0 SPI2_MOSI:5 TIM1_CH3N:1 GPIO
29|I/O|PA8||FMPI2C1_SCL:4 RCC_MCO_1:0 TIM1_CH1:1 USART1_CK:7 GPIO
30|I/O|PA9||DAC_EXTI9 TIM1_CH2:1 USART1_TX:7 GPIO
31|I/O|PA10||I2S5_SD:6 SPI5_MOSI:6 TIM1_CH3:1 USART1_RX:7 GPIO
32|I/O|PA11||ADC1_EXTI11 TIM1_CH4:1 USART1_CTS:7 USART6_TX:8 GPIO
33|I/O|PA12||SPI5_MISO:6 TIM1_ETR:1 USART1_RTS:7 USART6_RX:8 GPIO
34|I/O|PA13||SYS_JTMS-SWDIO:0 GPIO
35|Power|VSS||
36|Power|VDD||
37|I/O|PA14||SYS_JTCK-SWCLK:0 GPIO
38|I/O|PA15||ADC1_EXTI15 I2S1_WS:5 SPI1_NSS:5 SYS_JTDI:0 USART1_TX:7 GPIO
39|I/O|PB3||FMPI2C1_SDA:4 I2C2_SDA:9 I2S1_CK:5 SPI1_SCK:5 SYS_JTDO-SWO:0 USART1_RX:7 GPIO
40|I/O|PB4||SPI1_MISO:5 SYS_JTRST:0 GPIO
41|I/O|PB5||I2C1_SMBA:4 I2S1_SD:5 LPTIM1_IN1:1 SPI1_MOSI:5 GPIO
42|I/O|PB6||I2C1_SCL:4 LPTIM1_ETR:1 USART1_TX:7 GPIO
43|I/O|PB7||I2C1_SDA:4 LPTIM1_IN2:1 USART1_RX:7 GPIO
44|Boot|BOOT0||
45|I/O|PB8||I2C1_SCL:4 I2S5_SD:6 LPTIM1_OUT:1 SPI5_MOSI:6 GPIO
46|Power|VSS||
47|Power|PDR_ON||
48|Power|VDD||

[Params]
# Что можно настроить на выводе. Значения РАЗНЫЕ по семействам
# (у H7 скорость имеет VERY_HIGH, у F0 — нет), поэтому они данными.
# имя|подпись|значение по умолчанию
GPIO_Mode|GPIO mode|
GPIO_PuPd|GPIO Pull-up/Pull-down|GPIO_NOPULL
GPIO_Speed|Maximum output speed|GPIO_SPEED_FREQ_LOW
PinState|GPIO output level|GPIO_PIN_RESET

[ParamValues]
# параметр|значение|подпись (подписи из базы, в них бывают пробелы)
GPIO_Mode|GPIO_MODE_INPUT|Input mode
GPIO_Mode|GPIO_MODE_OUTPUT_PP|Output Push Pull
GPIO_Mode|GPIO_MODE_OUTPUT_OD|Output Open Drain
GPIO_Mode|GPIO_MODE_AF_PP|Alternate Function Push Pull
GPIO_Mode|GPIO_MODE_AF_OD|Alternate Function Open Drain
GPIO_Mode|GPIO_MODE_ANALOG|Analog mode
GPIO_Mode|GPIO_MODE_IT_RISING|External Interrupt Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_IT_FALLING|External Interrupt Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_IT_RISING_FALLING|External Interrupt Mode with Rising/Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING|External Event Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_FALLING|External Event Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING_FALLING|External Event Mode with Rising/Falling edge trigger detection
GPIO_PuPd|GPIO_NOPULL|No pull-up and no pull-down
GPIO_PuPd|GPIO_PULLUP|Pull-up
GPIO_PuPd|GPIO_PULLDOWN|Pull-down
GPIO_Speed|GPIO_SPEED_FREQ_LOW|Low
GPIO_Speed|GPIO_SPEED_FREQ_MEDIUM|Medium
GPIO_Speed|GPIO_SPEED_FREQ_HIGH|High
GPIO_Speed|GPIO_SPEED_FREQ_VERY_HIGH|Very High
PinState|GPIO_PIN_RESET|Low
PinState|GPIO_PIN_SET|High
