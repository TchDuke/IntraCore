# STM32WB07CCVx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WB07CCVx
Rpn=STM32WB07CC
CmsisDevice=
Family=STM32WB0
Line=STM32WBx7
ClockTree=STM32WB0
Package=VFQFPN48
Core=Arm Cortex-M0+
FrequencyMHz=0
Ram=65536
Flash=262144
IoCount=32
AfScheme=Numbered

