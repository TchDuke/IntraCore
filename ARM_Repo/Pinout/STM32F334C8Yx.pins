# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F334C8Yx
Rpn=STM32F334C8
CmsisDevice=STM32F334x8
Family=STM32F3
Line=STM32F334
ClockTree=STM32F3
Package=WLCSP49
Core=Arm Cortex-M4
FrequencyMHz=72
Ram=16384
Flash=65536
IoCount=38
AfScheme=Numbered

