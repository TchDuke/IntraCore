# STM32L083CZTx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L083CZTx
Rpn=STM32L083CZ
CmsisDevice=STM32L083xx
Family=STM32L0
Line=STM32L0x3
ClockTree=STM32L0
Package=LQFP48
Core=Arm Cortex-M0+
FrequencyMHz=32
Ram=20480
Flash=196608
IoCount=37
AfScheme=Numbered

