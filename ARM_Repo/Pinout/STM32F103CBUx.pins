# STM32F103CBUx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F103CBUx
Rpn=STM32F103CB
CmsisDevice=STM32F103xB
Family=STM32F1
Line=STM32F103
ClockTree=STM32F102
Package=UFQFPN48
Core=Arm Cortex-M3
FrequencyMHz=72
Ram=20480
Flash=131072
IoCount=37
AfScheme=F1Remap

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|Power|VBAT||
2|I/O|PC13-TAMPER-RTC||RTC_OUT RTC_TAMPER GPIO
3|I/O|PC14-OSC32_IN||RCC_OSC32_IN GPIO
4|I/O|PC15-OSC32_OUT||ADC1_EXTI15 ADC2_EXTI15 RCC_OSC32_OUT GPIO
5|I/O|PD0-OSC_IN||RCC_OSC_IN GPIO
6|I/O|PD1-OSC_OUT||RCC_OSC_OUT GPIO
7|Reset|NRST||
8|Power|VSSA||
9|Power|VDDA||
10|I/O|PA0-WKUP||ADC1_IN0 ADC2_IN0 SYS_WKUP TIM2_CH1 TIM2_ETR USART2_CTS GPIO
11|I/O|PA1||ADC1_IN1 ADC2_IN1 TIM2_CH2 USART2_RTS GPIO
12|I/O|PA2||ADC1_IN2 ADC2_IN2 TIM2_CH3 USART2_TX GPIO
13|I/O|PA3||ADC1_IN3 ADC2_IN3 TIM2_CH4 USART2_RX GPIO
14|I/O|PA4||ADC1_IN4 ADC2_IN4 SPI1_NSS USART2_CK GPIO
15|I/O|PA5||ADC1_IN5 ADC2_IN5 SPI1_SCK GPIO
16|I/O|PA6||ADC1_IN6 ADC2_IN6 SPI1_MISO TIM1_BKIN TIM3_CH1 GPIO
17|I/O|PA7||ADC1_IN7 ADC2_IN7 SPI1_MOSI TIM1_CH1N TIM3_CH2 GPIO
18|I/O|PB0||ADC1_IN8 ADC2_IN8 TIM1_CH2N TIM3_CH3 GPIO
19|I/O|PB1||ADC1_IN9 ADC2_IN9 TIM1_CH3N TIM3_CH4 GPIO
20|I/O|PB2||GPIO
21|I/O|PB10||I2C2_SCL TIM2_CH3 USART3_TX GPIO
22|I/O|PB11||ADC1_EXTI11 ADC2_EXTI11 I2C2_SDA TIM2_CH4 USART3_RX GPIO
23|Power|VSS||
24|Power|VDD||
25|I/O|PB12||I2C2_SMBA SPI2_NSS TIM1_BKIN USART3_CK GPIO
26|I/O|PB13||SPI2_SCK TIM1_CH1N USART3_CTS GPIO
27|I/O|PB14||SPI2_MISO TIM1_CH2N USART3_RTS GPIO
28|I/O|PB15||ADC1_EXTI15 ADC2_EXTI15 SPI2_MOSI TIM1_CH3N GPIO
29|I/O|PA8||RCC_MCO TIM1_CH1 USART1_CK GPIO
30|I/O|PA9||TIM1_CH2 USART1_TX GPIO
31|I/O|PA10||TIM1_CH3 USART1_RX GPIO
32|I/O|PA11||ADC1_EXTI11 ADC2_EXTI11 CAN_RX TIM1_CH4 USART1_CTS USB_DM GPIO
33|I/O|PA12||CAN_TX TIM1_ETR USART1_RTS USB_DP GPIO
34|I/O|PA13||SYS_JTMS-SWDIO GPIO
35|Power|VSS||
36|Power|VDD||
37|I/O|PA14||SYS_JTCK-SWCLK GPIO
38|I/O|PA15||ADC1_EXTI15 ADC2_EXTI15 SPI1_NSS SYS_JTDI TIM2_CH1 TIM2_ETR GPIO
39|I/O|PB3||SPI1_SCK SYS_JTDO-TRACESWO TIM2_CH2 GPIO
40|I/O|PB4||SPI1_MISO SYS_NJTRST TIM3_CH1 GPIO
41|I/O|PB5||I2C1_SMBA SPI1_MOSI TIM3_CH2 GPIO
42|I/O|PB6||I2C1_SCL TIM4_CH1 USART1_TX GPIO
43|I/O|PB7||I2C1_SDA TIM4_CH2 USART1_RX GPIO
44|Boot|BOOT0||
45|I/O|PB8||CAN_RX I2C1_SCL TIM4_CH3 GPIO
46|I/O|PB9||CAN_TX I2C1_SDA TIM4_CH4 GPIO
47|Power|VSS||
48|Power|VDD||

[Params]
# Что можно настроить на выводе. Значения РАЗНЫЕ по семействам
# (у H7 скорость имеет VERY_HIGH, у F0 — нет), поэтому они данными.
# имя|подпись|значение по умолчанию
GPIO_Mode|GPIO mode|
GPIO_PuPd|GPIO Pull-up/Pull-down|GPIO_NOPULL
GPIO_Speed|Maximum output speed|GPIO_SPEED_FREQ_LOW
PinState|GPIO output level|GPIO_PIN_RESET

[ParamValues]
# параметр|значение|подпись (подписи из базы, в них бывают пробелы)
GPIO_Mode|GPIO_MODE_INPUT|Input mode
GPIO_Mode|GPIO_MODE_OUTPUT_PP|Output Push Pull
GPIO_Mode|GPIO_MODE_OUTPUT_OD|Output Open Drain
GPIO_Mode|GPIO_MODE_AF_PP|Alternate Function Push Pull
GPIO_Mode|GPIO_MODE_AF_OD|Alternate Function Open Drain
GPIO_Mode|GPIO_MODE_ANALOG|Analog mode
GPIO_Mode|GPIO_MODE_IT_RISING|External Interrupt Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_IT_FALLING|External Interrupt Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_IT_RISING_FALLING|External Interrupt Mode with Rising/Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING|External Event Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_FALLING|External Event Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING_FALLING|External Event Mode with Rising/Falling edge trigger detection
GPIO_PuPd|GPIO_NOPULL|No pull-up and no pull-down
GPIO_PuPd|GPIO_PULLUP|Pull-up
GPIO_PuPd|GPIO_PULLDOWN|Pull-down
GPIO_Speed|GPIO_SPEED_FREQ_LOW|Low
GPIO_Speed|GPIO_SPEED_FREQ_MEDIUM|Medium
GPIO_Speed|GPIO_SPEED_FREQ_HIGH|High
PinState|GPIO_PIN_RESET|Low
PinState|GPIO_PIN_SET|High

[Remap]
