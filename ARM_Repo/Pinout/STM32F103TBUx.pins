# STM32F103TBUx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F103TBUx
Rpn=STM32F103TB
CmsisDevice=STM32F103xB
Family=STM32F1
Line=STM32F103
ClockTree=STM32F102
Package=VFQFPN36
Core=Arm Cortex-M3
FrequencyMHz=72
Ram=20480
Flash=131072
IoCount=26
AfScheme=F1Remap

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|Power|VDD||
2|I/O|PD0-OSC_IN||RCC_OSC_IN GPIO
3|I/O|PD1-OSC_OUT||RCC_OSC_OUT GPIO
4|Reset|NRST||
5|Power|VSSA||
6|Power|VDDA||
7|I/O|PA0-WKUP||ADC1_IN0 ADC2_IN0 SYS_WKUP TIM2_CH1 TIM2_ETR USART2_CTS GPIO
8|I/O|PA1||ADC1_IN1 ADC2_IN1 TIM2_CH2 USART2_RTS GPIO
9|I/O|PA2||ADC1_IN2 ADC2_IN2 TIM2_CH3 USART2_TX GPIO
10|I/O|PA3||ADC1_IN3 ADC2_IN3 TIM2_CH4 USART2_RX GPIO
11|I/O|PA4||ADC1_IN4 ADC2_IN4 SPI1_NSS USART2_CK GPIO
12|I/O|PA5||ADC1_IN5 ADC2_IN5 SPI1_SCK GPIO
13|I/O|PA6||ADC1_IN6 ADC2_IN6 SPI1_MISO TIM1_BKIN TIM3_CH1 GPIO
14|I/O|PA7||ADC1_IN7 ADC2_IN7 SPI1_MOSI TIM1_CH1N TIM3_CH2 GPIO
15|I/O|PB0||ADC1_IN8 ADC2_IN8 TIM1_CH2N TIM3_CH3 GPIO
16|I/O|PB1||ADC1_IN9 ADC2_IN9 TIM1_CH3N TIM3_CH4 GPIO
17|I/O|PB2||GPIO
18|Power|VSS||
19|Power|VDD||
20|I/O|PA8||RCC_MCO TIM1_CH1 USART1_CK GPIO
21|I/O|PA9||TIM1_CH2 USART1_TX GPIO
22|I/O|PA10||TIM1_CH3 USART1_RX GPIO
23|I/O|PA11||ADC1_EXTI11 ADC2_EXTI11 CAN_RX TIM1_CH4 USART1_CTS USB_DM GPIO
24|I/O|PA12||CAN_TX TIM1_ETR USART1_RTS USB_DP GPIO
25|I/O|PA13||SYS_JTMS-SWDIO GPIO
26|Power|VSS||
27|Power|VDD||
28|I/O|PA14||SYS_JTCK-SWCLK GPIO
29|I/O|PA15||ADC1_EXTI15 ADC2_EXTI15 SPI1_NSS SYS_JTDI TIM2_CH1 TIM2_ETR GPIO
30|I/O|PB3||SPI1_SCK SYS_JTDO-TRACESWO TIM2_CH2 GPIO
31|I/O|PB4||SPI1_MISO SYS_NJTRST TIM3_CH1 GPIO
32|I/O|PB5||I2C1_SMBA SPI1_MOSI TIM3_CH2 GPIO
33|I/O|PB6||I2C1_SCL TIM4_CH1 USART1_TX GPIO
34|I/O|PB7||I2C1_SDA TIM4_CH2 USART1_RX GPIO
35|Boot|BOOT0||
36|Power|VSS||

[Params]
# Что можно настроить на выводе. Значения РАЗНЫЕ по семействам
# (у H7 скорость имеет VERY_HIGH, у F0 — нет), поэтому они данными.
# имя|подпись|значение по умолчанию
GPIO_Mode|GPIO mode|
GPIO_PuPd|GPIO Pull-up/Pull-down|GPIO_NOPULL
GPIO_Speed|Maximum output speed|GPIO_SPEED_FREQ_LOW
PinState|GPIO output level|GPIO_PIN_RESET

[ParamValues]
# параметр|значение|подпись (подписи из базы, в них бывают пробелы)
GPIO_Mode|GPIO_MODE_INPUT|Input mode
GPIO_Mode|GPIO_MODE_OUTPUT_PP|Output Push Pull
GPIO_Mode|GPIO_MODE_OUTPUT_OD|Output Open Drain
GPIO_Mode|GPIO_MODE_AF_PP|Alternate Function Push Pull
GPIO_Mode|GPIO_MODE_AF_OD|Alternate Function Open Drain
GPIO_Mode|GPIO_MODE_ANALOG|Analog mode
GPIO_Mode|GPIO_MODE_IT_RISING|External Interrupt Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_IT_FALLING|External Interrupt Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_IT_RISING_FALLING|External Interrupt Mode with Rising/Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING|External Event Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_FALLING|External Event Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING_FALLING|External Event Mode with Rising/Falling edge trigger detection
GPIO_PuPd|GPIO_NOPULL|No pull-up and no pull-down
GPIO_PuPd|GPIO_PULLUP|Pull-up
GPIO_PuPd|GPIO_PULLDOWN|Pull-down
GPIO_Speed|GPIO_SPEED_FREQ_LOW|Low
GPIO_Speed|GPIO_SPEED_FREQ_MEDIUM|Medium
GPIO_Speed|GPIO_SPEED_FREQ_HIGH|High
PinState|GPIO_PIN_RESET|Low
PinState|GPIO_PIN_SET|High

[Remap]
# Только F1: сигнал доступен на выводе при такой настройке AFIO.
# вывод|сигнал|блок|макрос (пусто — вариант по умолчанию, настройки не нужно)
PA0-WKUP|TIM2_CH1|TIM2_REMAP0|
PA0-WKUP|TIM2_CH1|TIM2_REMAP2|__HAL_AFIO_REMAP_TIM2_PARTIAL_2
PA0-WKUP|TIM2_ETR|TIM2_REMAP0|
PA0-WKUP|TIM2_ETR|TIM2_REMAP2|__HAL_AFIO_REMAP_TIM2_PARTIAL_2
PA0-WKUP|USART2_CTS|USART2_REMAP0|
PA1|TIM2_CH2|TIM2_REMAP0|
