# STM32F412REYx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F412REYx
Rpn=STM32F412RE
CmsisDevice=STM32F412Rx
Family=STM32F4
Line=STM32F412
ClockTree=STM32F412
Package=WLCSP64
Core=Arm Cortex-M4
FrequencyMHz=100
Ram=262144
Flash=524288
IoCount=50
AfScheme=Numbered

