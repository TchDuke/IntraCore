# STM32WB05TZFx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WB05TZFx
Rpn=STM32WB05TZ
CmsisDevice=
Family=STM32WB0
Line=STM32WBx5
ClockTree=STM32WB0
Package=WLCSP36
Core=Arm Cortex-M0+
FrequencyMHz=0
Ram=24576
Flash=196608
IoCount=20
AfScheme=Numbered

[Pins]
