# STM32L010RBTx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L010RBTx
Rpn=STM32L010RB
CmsisDevice=STM32L010xB
Family=STM32L0
Line=STM32L0x0 Value Line
ClockTree=STM32L0
Package=LQFP64
Core=Arm Cortex-M0+
FrequencyMHz=32
Ram=20480
Flash=131072
IoCount=51
AfScheme=Numbered

[Pins]
