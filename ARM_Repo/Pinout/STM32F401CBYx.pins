# STM32F401CBYx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F401CBYx
Rpn=STM32F401CBY6
CmsisDevice=
Family=STM32F4
Line=STM32F401
ClockTree=STM32F4_F401
Package=WLCSP49
Core=Arm Cortex-M4
FrequencyMHz=0
Ram=65536
Flash=131072
IoCount=36
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
