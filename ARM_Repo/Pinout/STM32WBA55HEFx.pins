# STM32WBA55HEFx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WBA55HEFx
Rpn=STM32WBA55HE
CmsisDevice=
Family=STM32WBA
Line=STM32WBAx5
ClockTree=STM32WBA
Package=WLCSP41
Core=Arm Cortex-M33
FrequencyMHz=100
Ram=98304
Flash=524288
IoCount=20
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
A6|Power|VDDRF||
A8|I/O|OSC_IN||RCC_OSC_IN
A10|Power|VDD||
A12|Power|VSSSMPS||
B5|Power|VDDANA||
B7|I/O|OSC_OUT||RCC_OSC_OUT
B9|Power|VSS||
B11|Power|VDD11||
B13|Power|VDDSMPS||
C2|MonoIO|RF||
C4|Power|VDDHPA||
C6|Power|VDDRFPA||
C8|I/O|PH3-BOOT0||PTA_GRANT:10 RF_EXTPABYP:11 TAMP_IN2 TAMP_OUT1 GPIO
C10|I/O|PB12||SAI1_SD_A:13 SPI1_RDY:5 TIM2_CH1:1 TIM2_ETR:2 TIM3_ETR:14 TSC_SYNC:9 USART1_TX:7 GPIO
C12|Power|VLXSMPS||
D1|Power|VSSRF||
D3|Power|VSSRF||
D5|Power|VSSRF||
D7|I/O|PA8||ADC4_IN1 LPTIM1_CH2:2 RCC_MCO:0 SAI1_FS_A:13 SPI3_RDY:6 TIM2_CH2:1 TSC_G1_IO1:9 USART1_RX:7 GPIO
D9|I/O|PA6||ADC4_IN3 I2C3_SCL:4 PWR_CSTOP:0 PWR_WKUP7 SAI1_CK2:3 SAI1_MCLK_A:13 SPI3_RDY:6 TIM2_CH4:1 TSC_G1_IO3:9 USART1_DE:7 USART1_RTS:7 GPIO
D11|I/O|PA7||ADC4_IN2 COMP1_OUT:12 I2C3_SDA:4 PWR_WKUP8 SAI1_SCK_A:13 TAMP_IN1 TAMP_OUT2 TIM2_CH3:1 TSC_G1_IO2:9 USART1_CTS:7 GPIO
D13|Power|VSSA||
E2|Reset|NRST||
E4|I/O|PB15||ADC4_EXTI15 I2C1_SMBA:4 I2C3_SMBA:6 LPUART1_CTS:8 PTA_GRANT:10 RF_EXTPABYP:11 TIM16_BKIN:14 TIM1_BKIN2:1 USART2_CTS:3 GPIO
E6|I/O|PA12||COMP2_OUT:12 PTA_STATUS:10 PWR_WKUP6 RF_ANTSW0:11 SPI1_NSS:5 TIM1_CH2:1 TSC_G3_IO4:9 USART2_TX:3 GPIO
E8|I/O|PA13 (JTMS/SWDIO)||DEBUG_JTMS-SWDIO:0 IR_OUT:1 PTA_PRIORITY:10 GPIO
E10|I/O|PA1||ADC4_IN8 COMP1_INM LPTIM2_CH2:13 LPUART1_RX:8 PWR_WKUP3 SAI1_CK1:3 SPI1_RDY:5 TIM17_CH1:14 TIM1_CH1N:1 TIM3_CH2:2 TSC_G2_IO1:9 USART1_CK:7 GPIO
E12|Power|VDDA||
F1|I/O|PA14 (JTCK/SWCLK)||COMP2_OUT:12 DEBUG_JTCK-SWCLK:0 PTA_STATUS:10 TAMP_IN3 TAMP_OUT6 USART2_TX:3 GPIO
F3|I/O|PA15 (JTDI)||ADC4_EXTI15 DEBUG_JTDI:0 I2C1_SCL:4 LPTIM1_CH2:2 PTA_STATUS:10 SPI1_MOSI:5 TIM17_BKIN:14 TIM1_ETR:1 TSC_G3_IO3:9 USART2_DE:3 USART2_RTS:3 GPIO
