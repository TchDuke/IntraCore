# STM32WB55RGVx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WB55RGVx
Rpn=STM32WB55RG
CmsisDevice=
Family=STM32WB
Line=STM32WBx5
ClockTree=STM32W
Package=VFQFPN68
Core=Arm Cortex-M4
FrequencyMHz=64
Ram=262144
Flash=1048576
IoCount=49
AfScheme=Numbered

