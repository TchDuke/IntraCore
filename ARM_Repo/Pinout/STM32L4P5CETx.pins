# STM32L4P5CETx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L4P5CETx
Rpn=STM32L4P5CE
CmsisDevice=STM32L4P5xx
Family=STM32L4+
Line=STM32L4P5/Q5
ClockTree=STM32L4RS
Package=LQFP48
Core=Arm Cortex-M4
FrequencyMHz=120
Ram=327680
Flash=524288
IoCount=38
AfScheme=Numbered

