# STM32WLE4J8Ix — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WLE4J8Ix
Rpn=STM32WLE4J8
CmsisDevice=
Family=STM32WL
Line=STM32WLEx
ClockTree=STM32WL
Package=UFBGA73
Core=Arm Cortex-M4
FrequencyMHz=48
Ram=20480
Flash=65536
IoCount=43
AfScheme=Numbered

