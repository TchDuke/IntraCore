# STM32WL5MOCHx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WL5MOCHx
Rpn=STM32WL5MOC
CmsisDevice=
Family=STM32WL
Line=STM32WL5x
ClockTree=STM32WL
Package=LGA92
Core=Arm Cortex-M4
FrequencyMHz=48
Ram=65536
Flash=262144
IoCount=40
AfScheme=Numbered

[Pins]
