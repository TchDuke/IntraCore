10|I/O|PA4||ADC1_IN9 COMP1_INM COMP2_INM DAC1_OUT1 LPTIM2_OUT:14 SAI1_FS_B:13 SPI1_NSS:5 SPI3_NSS:6 USART2_CK:7 GPIO
11|I/O|PA5||ADC1_IN10 COMP1_INM COMP2_INM DAC1_OUT2 LPTIM2_ETR:14 SPI1_SCK:5 TIM2_CH1:1 TIM2_ETR:2 GPIO
12|I/O|PA6||ADC1_IN11 COMP1_OUT:6 LPUART1_CTS:8 QUADSPI_BK1_IO3:10 SPI1_MISO:5 TIM16_CH1:14 TIM1_BKIN:1 TIM1_BKIN_COMP2:12 GPIO
13|I/O|PA7||ADC1_IN12 COMP2_OUT:12 I2C3_SCL:4 QUADSPI_BK1_IO2:10 SPI1_MOSI:5 TIM1_CH1N:1 GPIO
14|I/O|PB0||ADC1_IN15 COMP1_OUT:12 QUADSPI_BK1_IO1:10 SAI1_EXTCLK:13 SPI1_NSS:5 TIM1_CH2N:1 GPIO
