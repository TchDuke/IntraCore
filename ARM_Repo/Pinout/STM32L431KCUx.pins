# STM32L431KCUx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L431KCUx
Rpn=STM32L431KC
CmsisDevice=STM32L431xx
Family=STM32L4
Line=STM32L4x1
ClockTree=STM32L43
Package=UFQFPN32
Core=Arm Cortex-M4
FrequencyMHz=80
Ram=65536
Flash=262144
IoCount=26
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|Power|VDD||
2|I/O|PC14-OSC32_IN (PC14)||RCC_OSC32_IN GPIO
3|I/O|PC15-OSC32_OUT (PC15)||ADC1_EXTI15 RCC_OSC32_OUT GPIO
4|Reset|NRST||
5|Power|VDDA/VREF+||
6|I/O|PA0||ADC1_IN5 COMP1_INM COMP1_OUT:12 OPAMP1_VINP RCC_CK_IN RTC_TAMP2 SAI1_EXTCLK:13 SYS_WKUP1 TIM2_CH1:1 TIM2_ETR:14 USART2_CTS:7 GPIO
7|I/O|PA1||ADC1_IN6 COMP1_INP I2C1_SMBA:4 OPAMP1_VINM SPI1_SCK:5 TIM15_CH1N:14 TIM2_CH2:1 USART2_DE:7 USART2_RTS:7 GPIO
