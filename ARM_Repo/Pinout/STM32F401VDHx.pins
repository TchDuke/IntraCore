# STM32F401VDHx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F401VDHx
Rpn=STM32F401VD
CmsisDevice=STM32F401xE
Family=STM32F4
Line=STM32F401
ClockTree=STM32F4_F401
Package=UFBGA100
Core=Arm Cortex-M4
FrequencyMHz=84
Ram=98304
Flash=393216
IoCount=81
AfScheme=Numbered

