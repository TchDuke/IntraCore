# STM32F105V8Hx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F105V8Hx
Rpn=STM32F105V8
CmsisDevice=STM32F105xC
Family=STM32F1
Line=STM32F105/107
ClockTree=STM32F105
Package=LFBGA100
Core=Arm Cortex-M3
FrequencyMHz=72
Ram=65536
Flash=65536
IoCount=80
AfScheme=F1Remap

