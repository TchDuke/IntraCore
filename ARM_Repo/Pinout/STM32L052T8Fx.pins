# STM32L052T8Fx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L052T8Fx
Rpn=STM32L052T8
CmsisDevice=STM32L052xx
Family=STM32L0
Line=STM32L0x2
ClockTree=STM32L0
Package=WLCSP36
Core=Arm Cortex-M0+
FrequencyMHz=32
Ram=8192
Flash=65536
IoCount=29
AfScheme=Numbered

[Pins]
