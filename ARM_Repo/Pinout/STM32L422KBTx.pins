# STM32L422KBTx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L422KBTx
Rpn=STM32L422KB
CmsisDevice=STM32L422xx
Family=STM32L4
Line=STM32L4x2
ClockTree=STM32L4x2
Package=LQFP32
Core=Arm Cortex-M4
FrequencyMHz=80
Ram=40960
Flash=131072
IoCount=26
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|Power|VDD||
2|I/O|PC14-OSC32_IN (PC14)||RCC_OSC32_IN GPIO
3|I/O|PC15-OSC32_OUT (PC15)||ADC1_EXTI15 ADC2_EXTI15 RCC_OSC32_OUT GPIO
4|Reset|NRST||
5|Power|VDDA/VREF+||
6|I/O|PA0-CK_IN||ADC1_IN5 COMP1_INM COMP1_OUT:12 OPAMP1_VINP RCC_CK_IN RTC_TAMP2 SYS_WKUP1 TIM2_CH1:1 TIM2_ETR:14 USART2_CTS:7 GPIO
7|I/O|PA1||ADC1_IN6 COMP1_INP I2C1_SMBA:4 OPAMP1_VINM SPI1_SCK:5 TIM15_CH1N:14 TIM2_CH2:1 USART2_DE:7 USART2_RTS:7 GPIO
8|I/O|PA2||ADC1_IN7 ADC2_IN7 LPUART1_TX:8 QUADSPI_BK1_NCS:10 RCC_LSCO SYS_WKUP4 TIM15_CH1:14 TIM2_CH3:1 USART2_TX:7 GPIO
9|I/O|PA3||ADC1_IN8 ADC2_IN8 LPUART1_RX:8 OPAMP1_VOUT QUADSPI_CLK:10 TIM15_CH2:14 TIM2_CH4:1 USART2_RX:7 GPIO
10|I/O|PA4||ADC1_IN9 ADC2_IN9 COMP1_INM LPTIM2_OUT:14 SPI1_NSS:5 USART2_CK:7 GPIO
11|I/O|PA5||ADC1_IN10 ADC2_IN10 COMP1_INM LPTIM2_ETR:14 SPI1_SCK:5 TIM2_CH1:1 TIM2_ETR:2 GPIO
12|I/O|PA6||ADC1_IN11 ADC2_IN11 COMP1_OUT:6 LPUART1_CTS:8 QUADSPI_BK1_IO3:10 SPI1_MISO:5 TIM16_CH1:14 TIM1_BKIN:1 GPIO
13|I/O|PA7||ADC1_IN12 ADC2_IN12 I2C3_SCL:4 QUADSPI_BK1_IO2:10 SPI1_MOSI:5 TIM1_CH1N:1 GPIO
14|I/O|PB0||ADC1_IN15 ADC2_IN15 COMP1_OUT:12 QUADSPI_BK1_IO1:10 SPI1_NSS:5 SYS_TRACED0:0 TIM1_CH2N:1 GPIO
15|I/O|PB1||ADC1_IN16 ADC2_IN16 COMP1_INM LPTIM2_IN1:14 LPUART1_DE:8 LPUART1_RTS:8 QUADSPI_BK1_IO0:10 SYS_TRACED1:0 TIM1_CH3N:1 GPIO
16|Power|VSS||
17|Power|VDD||
18|I/O|PA8||LPTIM2_OUT:14 RCC_MCO:0 TIM1_CH1:1 USART1_CK:7 GPIO
19|I/O|PA9||I2C1_SCL:4 TIM15_BKIN:14 TIM1_CH2:1 USART1_TX:7 GPIO
20|I/O|PA10||CRS_SYNC:10 I2C1_SDA:4 TIM1_CH3:1 USART1_RX:7 GPIO
21|I/O|PA11||ADC1_EXTI11 ADC2_EXTI11 COMP1_OUT:6 SPI1_MISO:5 TIM1_BKIN2:2 TIM1_BKIN2_COMP1:12 TIM1_CH4:1 USART1_CTS:7 USB_DM:10 GPIO
22|I/O|PA12||SPI1_MOSI:5 TIM1_ETR:1 USART1_DE:7 USART1_RTS:7 USB_DP:10 GPIO
23|I/O|PA13 (JTMS/SWDIO)||IR_OUT:1 SYS_JTMS-SWDIO:0 USB_NOE:10 GPIO
24|I/O|PA14 (JTCK/SWCLK)||I2C1_SMBA:4 LPTIM1_OUT:1 SYS_JTCK-SWCLK:0 GPIO
