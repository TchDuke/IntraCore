# STM32F103V8Tx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F103V8Tx
Rpn=STM32F103V8
CmsisDevice=STM32F103xB
Family=STM32F1
Line=STM32F103
ClockTree=STM32F102
Package=LQFP100
Core=Arm Cortex-M3
FrequencyMHz=72
Ram=20480
Flash=65536
IoCount=80
AfScheme=F1Remap

