# STM32WB06CCFx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WB06CCFx
Rpn=STM32WB06CC
CmsisDevice=
Family=STM32WB0
Line=STM32WBx6
ClockTree=STM32WB0
Package=WLCSP49
Core=Arm Cortex-M0+
FrequencyMHz=0
Ram=32768
Flash=262144
IoCount=29
AfScheme=Numbered

[Pins]
