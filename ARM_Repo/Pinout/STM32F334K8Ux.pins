# STM32F334K8Ux — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F334K8Ux
Rpn=STM32F334K8
CmsisDevice=STM32F334x8
Family=STM32F3
Line=STM32F334
ClockTree=STM32F3
Package=UFQFPN32
Core=Arm Cortex-M4
FrequencyMHz=72
Ram=16384
Flash=65536
IoCount=24
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|Power|VDD||
2|I/O|PF0 / OSC_IN||RCC_OSC_IN TIM1_CH3N:6 GPIO
3|I/O|PF1 / OSC_OUT||RCC_OSC_OUT GPIO
4|Reset|NRST||
5|Power|VDDA/VREF+||
6|Power|VSSA/VREF-||
7|I/O|PA0||ADC1_IN1 RTC_TAMP2 SYS_WKUP1 TIM2_CH1:1 TIM2_ETR:1 TSC_G1_IO1:3 USART2_CTS:7 GPIO
8|I/O|PA1||ADC1_IN2 RTC_REFIN TIM15_CH1N:9 TIM2_CH2:1 TSC_G1_IO2:3 USART2_DE:7 USART2_RTS:7 GPIO
9|I/O|PA2||ADC1_IN3 COMP2_INM COMP2_OUT:8 TIM15_CH1:9 TIM2_CH3:1 TSC_G1_IO3:3 USART2_TX:7 GPIO
10|I/O|PA3||ADC1_IN4 TIM15_CH2:9 TIM2_CH4:1 TSC_G1_IO4:3 USART2_RX:7 GPIO
11|I/O|PA4||ADC2_IN1 COMP2_INM COMP4_INM DAC1_OUT1 SPI1_NSS:5 TIM3_CH2:2 TSC_G2_IO1:3 USART2_CK:7 GPIO
12|I/O|PA5||ADC2_IN2 DAC1_OUT2 OPAMP2_VINM OPAMP2_VINM_SEC SPI1_SCK:5 TIM2_CH1:1 TIM2_ETR:1 TSC_G2_IO2:3 GPIO
13|I/O|PA6||ADC2_IN3 DAC2_OUT1 OPAMP2_DIG:13 OPAMP2_VOUT SPI1_MISO:5 TIM16_CH1:1 TIM1_BKIN:6 TIM3_CH1:2 TSC_G2_IO3:3 GPIO
14|I/O|PA7||ADC2_IN4 COMP2_INP OPAMP2_VINP OPAMP2_VINP_SEC SPI1_MOSI:5 TIM17_CH1:1 TIM1_CH1N:6 TIM3_CH2:2 TSC_G2_IO4:3 GPIO
15|I/O|PB0||ADC1_IN11 COMP4_INP OPAMP2_VINP OPAMP2_VINP_SEC TIM1_CH2N:6 TIM3_CH3:2 TSC_G3_IO2:3 GPIO
16|Power|VSS||
17|Power|VDD||
18|I/O|PA8||HRTIM1_CHA1:13 RCC_MCO:0 TIM1_CH1:6 USART1_CK:7 GPIO
19|I/O|PA9||DAC1_EXTI9 DAC2_EXTI9 HRTIM1_CHA2:13 TIM15_BKIN:9 TIM1_CH2:6 TIM2_CH3:10 TSC_G4_IO1:3 USART1_TX:7 GPIO
20|I/O|PA10||HRTIM1_CHB1:13 TIM17_BKIN:1 TIM1_CH3:6 TIM2_CH4:10 TSC_G4_IO2:3 USART1_RX:7 GPIO
21|I/O|PA11||ADC1_EXTI11 ADC2_EXTI11 CAN_RX:9 HRTIM1_CHB2:13 TIM1_BKIN2:12 TIM1_CH1N:6 TIM1_CH4:11 USART1_CTS:7 GPIO
22|I/O|PA12||CAN_TX:9 COMP2_OUT:8 HRTIM1_FLT1:13 TIM16_CH1:1 TIM1_CH2N:6 TIM1_ETR:11 USART1_DE:7 USART1_RTS:7 GPIO
23|I/O|PA13||IR_OUT:5 SYS_JTMS-SWDIO:0 TIM16_CH1N:1 TSC_G4_IO3:3 GPIO
