# STM32F051K6Tx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F051K6Tx
Rpn=STM32F051K6
CmsisDevice=STM32F051x8
Family=STM32F0
Line=STM32F0x1
ClockTree=STM32F0
Package=LQFP32
Core=Arm Cortex-M0
FrequencyMHz=48
Ram=8192
Flash=32768
IoCount=25
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|Power|VDD||
2|I/O|PF0-OSC_IN||RCC_OSC_IN GPIO
3|I/O|PF1-OSC_OUT||RCC_OSC_OUT GPIO
4|Reset|NRST||
5|Power|VDDA||
6|I/O|PA0||ADC_IN0 COMP1_INM:7 COMP1_OUT:7 RTC_TAMP2:0 SYS_WKUP1:0 TIM2_CH1:2 TIM2_ETR:2 TSC_G1_IO1:3 USART2_CTS:1 GPIO
7|I/O|PA1||ADC_IN1 COMP1_INP:7 TIM2_CH2:2 TSC_G1_IO2:3 USART2_DE:1 USART2_RTS:1 GPIO
8|I/O|PA2||ADC_IN2 COMP2_INM:7 COMP2_OUT:7 TIM15_CH1:0 TIM2_CH3:2 TSC_G1_IO3:3 USART2_TX:1 GPIO
9|I/O|PA3||ADC_IN3 COMP2_INP:7 TIM15_CH2:0 TIM2_CH4:2 TSC_G1_IO4:3 USART2_RX:1 GPIO
10|I/O|PA4||ADC_IN4 COMP1_INM:7 COMP2_INM:7 DAC1_OUT1 I2S1_WS:0 SPI1_NSS:0 TIM14_CH1:4 TSC_G2_IO1:3 USART2_CK:1 GPIO
11|I/O|PA5||ADC_IN5 CEC:1 COMP1_INM:7 COMP2_INM:7 I2S1_CK:0 SPI1_SCK:0 TIM2_CH1:2 TIM2_ETR:2 TSC_G2_IO2:3 GPIO
12|I/O|PA6||ADC_IN6 COMP1_OUT:7 I2S1_MCK:0 SPI1_MISO:0 TIM16_CH1:5 TIM1_BKIN:2 TIM3_CH1:1 TSC_G2_IO3:3 GPIO
13|I/O|PA7||ADC_IN7 COMP2_OUT:7 I2S1_SD:0 SPI1_MOSI:0 TIM14_CH1:4 TIM17_CH1:5 TIM1_CH1N:2 TIM3_CH2:1 TSC_G2_IO4:3 GPIO
14|I/O|PB0||ADC_IN8 TIM1_CH2N:2 TIM3_CH3:1 TSC_G3_IO2:3 GPIO
15|I/O|PB1||ADC_IN9 TIM14_CH1:0 TIM1_CH3N:2 TIM3_CH4:1 TSC_G3_IO3:3 GPIO
16|Power|VSS||
17|Power|VDD||
18|I/O|PA8||RCC_MCO:0 TIM1_CH1:2 USART1_CK:1 GPIO
19|I/O|PA9||DAC1_EXTI9 TIM15_BKIN:0 TIM1_CH2:2 TSC_G4_IO1:3 USART1_TX:1 GPIO
20|I/O|PA10||TIM17_BKIN:0 TIM1_CH3:2 TSC_G4_IO2:3 USART1_RX:1 GPIO
21|I/O|PA11||COMP1_OUT:7 TIM1_CH4:2 TSC_G4_IO3:3 USART1_CTS:1 GPIO
22|I/O|PA12||COMP2_OUT:7 TIM1_ETR:2 TSC_G4_IO4:3 USART1_DE:1 USART1_RTS:1 GPIO
23|I/O|PA13||IR_OUT:1 SYS_SWDIO GPIO
24|I/O|PA14||SYS_SWCLK:0 USART2_TX:1 GPIO
25|I/O|PA15||I2S1_WS:0 SPI1_NSS:0 TIM2_CH1:2 TIM2_ETR:2 USART2_RX:1 GPIO
26|I/O|PB3||I2S1_CK:0 SPI1_SCK:0 TIM2_CH2:2 TSC_G5_IO1:3 GPIO
27|I/O|PB4||I2S1_MCK:0 SPI1_MISO:0 TIM3_CH1:1 TSC_G5_IO2:3 GPIO
28|I/O|PB5||I2C1_SMBA:3 I2S1_SD:0 SPI1_MOSI:0 TIM16_BKIN:2 TIM3_CH2:1 GPIO
29|I/O|PB6||I2C1_SCL:1 TIM16_CH1N:2 TSC_G5_IO3:3 USART1_TX:0 GPIO
30|I/O|PB7||I2C1_SDA:1 TIM17_CH1N:2 TSC_G5_IO4:3 USART1_RX:0 GPIO
31|Boot|BOOT0||
32|Power|VSS||

[Params]
# Что можно настроить на выводе. Значения РАЗНЫЕ по семействам
# (у H7 скорость имеет VERY_HIGH, у F0 — нет), поэтому они данными.
# имя|подпись|значение по умолчанию
GPIO_Mode|GPIO mode|
GPIO_PuPd|GPIO Pull-up/Pull-down|GPIO_NOPULL
GPIO_Speed|Maximum output speed|GPIO_SPEED_FREQ_LOW
PinState|GPIO output level|GPIO_PIN_RESET

[ParamValues]
# параметр|значение|подпись (подписи из базы, в них бывают пробелы)
GPIO_Mode|GPIO_MODE_INPUT|Input mode
GPIO_Mode|GPIO_MODE_OUTPUT_PP|Output Push Pull
GPIO_Mode|GPIO_MODE_OUTPUT_OD|Output Open Drain
GPIO_Mode|GPIO_MODE_AF_PP|Alternate Function Push Pull
GPIO_Mode|GPIO_MODE_AF_OD|Alternate Function Open Drain
GPIO_Mode|GPIO_MODE_ANALOG|Analog mode
GPIO_Mode|GPIO_MODE_IT_RISING|External Interrupt Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_IT_FALLING|External Interrupt Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_IT_RISING_FALLING|External Interrupt Mode with Rising/Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING|External Event Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_FALLING|External Event Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING_FALLING|External Event Mode with Rising/Falling edge trigger detection
GPIO_PuPd|GPIO_NOPULL|No pull-up and no pull-down
GPIO_PuPd|GPIO_PULLUP|Pull-up
GPIO_PuPd|GPIO_PULLDOWN|Pull-down
GPIO_Speed|GPIO_SPEED_FREQ_LOW|Low
GPIO_Speed|GPIO_SPEED_FREQ_MEDIUM|Medium
GPIO_Speed|GPIO_SPEED_FREQ_HIGH|High
PinState|GPIO_PIN_RESET|Low
PinState|GPIO_PIN_SET|High
