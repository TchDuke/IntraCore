# STM32F103RDYx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F103RDYx
Rpn=STM32F103RD
CmsisDevice=STM32F103xE
Family=STM32F1
Line=STM32F103
ClockTree=STM32F102
Package=WLCSP64
Core=Arm Cortex-M3
FrequencyMHz=72
Ram=65536
Flash=393216
IoCount=50
AfScheme=F1Remap

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
A1|Power|VDD||
A2|I/O|PC10||SDIO_D2 UART4_TX USART3_TX GPIO
A3|I/O|PD2||SDIO_CMD TIM3_ETR UART5_RX GPIO
A4|I/O|PB3||I2S3_CK SPI1_SCK SPI3_SCK SYS_JTDO-TRACESWO TIM2_CH2 GPIO
A5|I/O|PB5||I2C1_SMBA I2S3_SD SPI1_MOSI SPI3_MOSI TIM3_CH2 GPIO
A6|Boot|BOOT0||
A7|Power|VSS||
A8|Power|VDD||
B1|Power|VSS||
B2|I/O|PA14||SYS_JTCK-SWCLK GPIO
B3|I/O|PC11||ADC1_EXTI11 ADC2_EXTI11 SDIO_D3 UART4_RX USART3_RX GPIO
