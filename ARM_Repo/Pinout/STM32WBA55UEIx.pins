# STM32WBA55UEIx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WBA55UEIx
Rpn=STM32WBA55UE
CmsisDevice=
Family=STM32WBA
Line=STM32WBAx5
ClockTree=STM32WBA
Package=UFBGA59
Core=Arm Cortex-M33
FrequencyMHz=100
Ram=98304
Flash=524288
IoCount=35
AfScheme=Numbered

[Pins]
