# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F072VBHx
Rpn=STM32F072VB
CmsisDevice=STM32F072xB
Family=STM32F0
Line=STM32F0x2
ClockTree=STM32F0
Package=UFBGA100
Core=Arm Cortex-M0
FrequencyMHz=48
Ram=16384
Flash=131072
IoCount=87
AfScheme=Numbered

