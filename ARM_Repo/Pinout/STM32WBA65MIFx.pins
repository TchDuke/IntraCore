# STM32WBA65MIFx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WBA65MIFx
Rpn=STM32WBA65MI
CmsisDevice=
Family=STM32WBA
Line=STM32WBAx5
ClockTree=STM32WBA6
Package=WLCSP88_SMPS_USB
Core=Arm Cortex-M33
FrequencyMHz=100
Ram=524288
Flash=2097152
IoCount=52
AfScheme=Numbered

