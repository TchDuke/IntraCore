# STM32WBA23KEUx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WBA23KEUx
Rpn=STM32WBA23K
CmsisDevice=
Family=STM32WBA
Line=STM32WBAx3
ClockTree=STM32WBA2
Package=UFQFPN32
Core=Arm Cortex-M33
FrequencyMHz=0
Ram=98304
Flash=524288
IoCount=20
AfScheme=Numbered

