# STM32WBA54CGUx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WBA54CGUx
Rpn=STM32WBA54CG
CmsisDevice=
Family=STM32WBA
Line=STM32WBAx4
ClockTree=STM32WBA
Package=UFQFPN48
Core=Arm Cortex-M33
FrequencyMHz=100
Ram=131072
Flash=1048576
IoCount=35
AfScheme=Numbered

