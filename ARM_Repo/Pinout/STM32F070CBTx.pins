# STM32F070CBTx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F070CBTx
Rpn=STM32F070CB
CmsisDevice=STM32F070xB
Family=STM32F0
Line=STM32F0x0 Value Line
ClockTree=STM32F0
Package=LQFP48
Core=Arm Cortex-M0
FrequencyMHz=48
Ram=16384
Flash=131072
IoCount=37
AfScheme=Numbered

[Pins]
