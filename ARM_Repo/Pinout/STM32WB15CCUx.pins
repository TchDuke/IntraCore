# STM32WB15CCUx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WB15CCUx
Rpn=STM32WB15CC
CmsisDevice=
Family=STM32WB
Line=STM32WBx5
ClockTree=STM32WB1
Package=UFQFPN48
Core=Arm Cortex-M4
FrequencyMHz=64
Ram=49152
Flash=327680
IoCount=30
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|Power|VBAT||
