# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F205RGEx
Rpn=STM32F205RG
CmsisDevice=STM32F205xx
Family=STM32F2
Line=STM32F2x5
ClockTree=STM32F2_F205-F207-F215-F217
Package=EWLCSP66
Core=Arm Cortex-M3
FrequencyMHz=120
Ram=131072
Flash=1048576
IoCount=51
AfScheme=Numbered

