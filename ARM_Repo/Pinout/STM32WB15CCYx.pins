# STM32WB15CCYx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WB15CCYx
Rpn=STM32WB15CC
CmsisDevice=
Family=STM32WB
Line=STM32WBx5
ClockTree=STM32WB1
Package=WLCSP49
Core=Arm Cortex-M4
FrequencyMHz=64
Ram=49152
Flash=327680
IoCount=26
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
A1|Power|VDDSMPS||
A2|I/O|PA11||ADC1_EXTI11 SPI1_MISO:5 TIM1_BKIN2:2 TIM1_CH4:1 USART1_CTS:7 USART1_NSS:7 GPIO
A3|I/O|PA12||LPUART1_RX:8 SPI1_MOSI:5 TIM1_ETR:1 USART1_DE:7 USART1_RTS:7 GPIO
A4|Power|VDD||
A5|I/O|PB5||I2C1_SMBA:4 LPTIM1_IN1:1 LPUART1_TX:8 SPI1_MOSI:5 TSC_G2_IO2:9 USART1_CK:7 GPIO
A6|I/O|PB7||I2C1_SDA:4 LPTIM1_IN2:1 SYS_PVD_IN TIM1_BKIN:3 TIM1_CH3:12 TSC_G2_IO4:9 USART1_RX:7 GPIO
A7|I/O|PC14-OSC32_IN||RCC_OSC32_IN GPIO
B1|Power|VLXSMPS||
B2|I/O|PA13||SPI1_MOSI:5 SYS_JTMS-SWDIO:0 TSC_G7_IO1:9 GPIO
B3|I/O|PA14||I2C1_SMBA:4 LPTIM1_OUT:1 SPI1_NSS:5 SYS_JTCK-SWCLK:0 GPIO
B4|I/O|PB4||SPI1_MISO:5 SYS_JTRST:0 TSC_G2_IO1:9 USART1_CTS:7 USART1_NSS:7 GPIO
B5|I/O|PB6||I2C1_SCL:4 LPTIM1_ETR:1 RCC_MCO:0 SPI1_NSS:5 TSC_G2_IO3:9 USART1_TX:7 GPIO
B6|I/O|PH3-BOOT0||RCC_LSCO:0 GPIO
B7|I/O|PC15-OSC32_OUT||RCC_OSC32_OUT GPIO
C1|Power|VSSSMPS||
C2|I/O|PA10||I2C1_SDA:4 TIM1_CH3:1 TSC_G7_IO2:9 USART1_RX:7 GPIO
C3|Power|VSS||
C4|I/O|PA0||ADC1_IN5 COMP1_INM COMP1_OUT:12 RTC_TAMP2 SYS_WKUP1 TIM2_CH1:1 TIM2_ETR:14 GPIO
C5|Power|VBAT||
C6|I/O|PB8||I2C1_SCL:4 TIM1_CH2N:1 TSC_G7_IO3:9 GPIO
C7|Reset|NRST(PB11)||
D1|Power|VDD||
D2|Power|VFBSMPS||
D3|I/O|PA9||ADC1_IN4 COMP1_INM I2C1_SCL:4 TIM1_CH2:1 USART1_TX:7 GPIO
D4|I/O|PA5||ADC1_IN10 COMP1_INM LPTIM2_ETR:14 SPI1_MOSI:4 SPI1_SCK:5 TIM2_CH1:1 TIM2_ETR:2 GPIO
D5|I/O|PA3||ADC1_IN8 LPUART1_RX:8 TIM2_CH4:1 GPIO
D6|Power|VSS||
D7|Power|VDD||
E1|I/O|PB1||LPTIM2_IN1:14 LPUART1_DE:8 LPUART1_RTS:8 GPIO
E2|I/O|PB0||COMP1_OUT:12 RF_TX_MOD_EXT_PA:6 GPIO
E3|NC|AT0||
E4|I/O|PB2||COMP1_INP LPTIM1_OUT:1 RTC_OUT:0 SPI1_NSS:5 GPIO
E5|I/O|PA7||ADC1_IN2 SPI1_MOSI:5 TIM1_CH1N:1 GPIO
E6|I/O|PA2||ADC1_IN7 LPUART1_TX:8 RCC_LSCO:0 SYS_WKUP4 TIM2_CH3:1 GPIO
E7|Power|VDDA||
F1|MonoIO|OSC_IN||RCC_OSC_IN
F2|MonoIO|OSC_OUT||RCC_OSC_OUT
F3|NC|AT1||
F4|Power|VSSRF||
F5|Power|VSS||
F6|I/O|PA6||ADC1_IN11 LPUART1_CTS:8 SPI1_MISO:5 TIM1_BKIN:1 GPIO
F7|I/O|PA1||ADC1_IN6 COMP1_INP I2C1_SMBA:4 SPI1_SCK:5 TIM2_CH2:1 GPIO
G1|Power|VSSRF||
G2|Power|VDDRF||
G3|Power|VSSRF||
G4|MonoIO|RF1||RF_RF1
G5|Power|VDD||
G6|I/O|PA8||ADC1_IN3 LPTIM2_OUT:14 RCC_MCO:0 TIM1_CH1:1 USART1_CK:7 GPIO
G7|I/O|PA4||ADC1_IN9 COMP1_INM LPTIM2_OUT:14 SPI1_NSS:5 GPIO

[Params]
# Что можно настроить на выводе. Значения РАЗНЫЕ по семействам
# (у H7 скорость имеет VERY_HIGH, у F0 — нет), поэтому они данными.
# имя|подпись|значение по умолчанию
GPIO_Mode|GPIO mode|
GPIO_PuPd|GPIO Pull-up/Pull-down|GPIO_NOPULL
GPIO_Speed|Maximum output speed|GPIO_SPEED_FREQ_LOW
PinState|GPIO output level|GPIO_PIN_RESET

[ParamValues]
# параметр|значение|подпись (подписи из базы, в них бывают пробелы)
GPIO_Mode|GPIO_MODE_INPUT|Input mode
GPIO_Mode|GPIO_MODE_OUTPUT_PP|Output Push Pull
GPIO_Mode|GPIO_MODE_OUTPUT_OD|Output Open Drain
GPIO_Mode|GPIO_MODE_AF_PP|Alternate Function Push Pull
GPIO_Mode|GPIO_MODE_AF_OD|Alternate Function Open Drain
GPIO_Mode|GPIO_MODE_ANALOG|Analog mode
GPIO_Mode|GPIO_MODE_ANALOG_ADC_CONTROL|Analog mode for ADC conversion
GPIO_Mode|GPIO_MODE_IT_RISING|External Interrupt Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_IT_FALLING|External Interrupt Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_IT_RISING_FALLING|External Interrupt Mode with Rising/Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING|External Event Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_FALLING|External Event Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING_FALLING|External Event Mode with Rising/Falling edge trigger detection
GPIO_PuPd|GPIO_NOPULL|No pull-up and no pull-down
GPIO_PuPd|GPIO_PULLUP|Pull-up
GPIO_PuPd|GPIO_PULLDOWN|Pull-down
GPIO_Speed|GPIO_SPEED_FREQ_LOW|Low
GPIO_Speed|GPIO_SPEED_FREQ_MEDIUM|Medium
GPIO_Speed|GPIO_SPEED_FREQ_HIGH|High
GPIO_Speed|GPIO_SPEED_FREQ_VERY_HIGH|Very High
PinState|GPIO_PIN_RESET|Low
PinState|GPIO_PIN_SET|High
