# STM32WB55CGUx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WB55CGUx
Rpn=STM32WB55CG
CmsisDevice=
Family=STM32WB
Line=STM32WBx5
ClockTree=STM32W
Package=UFQFPN48
Core=Arm Cortex-M4
FrequencyMHz=64
Ram=262144
Flash=1048576
IoCount=30
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|Power|VBAT||
