# STM32L552CEUxP — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L552CEUxP
Rpn=STM32L552CE
CmsisDevice=STM32L552xx
Family=STM32L5
Line=STM32L5x2
ClockTree=STM32L5
Package=UFQFPN48
Core=Arm Cortex-M33
FrequencyMHz=110
Ram=262144
Flash=524288
IoCount=36
AfScheme=Numbered

