# STM32L041K6Tx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L041K6Tx
Rpn=STM32L041K6
CmsisDevice=STM32L041xx
Family=STM32L0
Line=STM32L0x1
ClockTree=STM32L0
Package=LQFP32
Core=Arm Cortex-M0+
FrequencyMHz=32
Ram=8192
Flash=32768
IoCount=25
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|Power|VDD||
2|I/O|PC14-OSC32_IN||RCC_OSC32_IN GPIO
3|I/O|PC15-OSC32_OUT||RCC_OSC32_OUT GPIO
4|Reset|NRST||
5|Power|VDDA||
6|I/O|PA0-CK_IN||ADC_IN0 COMP1_INM COMP1_OUT:7 LPTIM1_IN1:1 RCC_CK_IN RTC_TAMP2 SYS_WKUP1 TIM2_CH1:2 TIM2_ETR:5 USART2_CTS:4 GPIO
7|I/O|PA1||ADC_IN1 COMP1_INP I2C1_SMBA:3 LPTIM1_IN2:1 TIM21_ETR:5 TIM2_CH2:2 USART2_DE:4 USART2_RTS:4 GPIO
8|I/O|PA2||ADC_IN2 COMP2_INM COMP2_OUT:7 LPUART1_TX:6 RTC_OUT_ALARM RTC_OUT_CALIB RTC_TAMP3 RTC_TS SYS_WKUP3 TIM21_CH1:0 TIM2_CH3:2 USART2_TX:4 GPIO
9|I/O|PA3||ADC_IN3 COMP2_INP LPUART1_RX:6 TIM21_CH2:0 TIM2_CH4:2 USART2_RX:4 GPIO
10|I/O|PA4||ADC_IN4 COMP1_INM COMP2_INM LPTIM1_IN1:1 SPI1_NSS:0 TIM22_ETR:5 USART2_CK:4 GPIO
11|I/O|PA5||ADC_IN5 COMP1_INM COMP2_INM LPTIM1_IN2:1 SPI1_SCK:0 TIM2_CH1:5 TIM2_ETR:2 GPIO
12|I/O|PA6||ADC_IN6 COMP1_OUT:7 LPTIM1_ETR:1 LPUART1_CTS:4 SPI1_MISO:0 TIM22_CH1:5 GPIO
13|I/O|PA7||ADC_IN7 COMP2_OUT:7 LPTIM1_OUT:1 SPI1_MOSI:0 TIM22_CH2:5 USART2_CTS:4 GPIO
14|I/O|PB0||ADC_IN8 SPI1_MISO:1 SYS_VREF_OUT_PB0 TIM2_CH3:5 USART2_DE:4 USART2_RTS:4 GPIO
15|I/O|PB1||ADC_IN9 LPUART1_DE:4 LPUART1_RTS:4 SPI1_MOSI:1 SYS_VREF_OUT_PB1 TIM2_CH4:5 USART2_CK:0 GPIO
16|Power|VSS||
17|Power|VDD||
18|I/O|PA8||LPTIM1_IN1:2 RCC_MCO:0 TIM2_CH1:5 USART2_CK:4 GPIO
19|I/O|PA9||I2C1_SCL:1 RCC_MCO:0 TIM22_CH1:5 USART2_TX:4 GPIO
20|I/O|PA10||I2C1_SDA:1 TIM22_CH2:5 USART2_RX:4 GPIO
21|I/O|PA11||ADC_EXTI11 COMP1_OUT:7 SPI1_MISO:0 TIM21_CH2:5 USART2_CTS:4 GPIO
22|I/O|PA12||COMP2_OUT:7 SPI1_MOSI:0 USART2_DE:4 USART2_RTS:4 GPIO
23|I/O|PA13||LPTIM1_ETR:1 LPUART1_RX:6 SYS_SWDIO:0 GPIO
24|I/O|PA14||I2C1_SMBA:3 LPTIM1_OUT:1 LPUART1_TX:6 SYS_SWCLK:0 USART2_TX:4 GPIO
25|I/O|PA15||SPI1_NSS:0 TIM2_CH1:5 TIM2_ETR:2 USART2_RX:4 GPIO
26|I/O|PB3||COMP2_INM SPI1_SCK:0 TIM2_CH2:2 GPIO
27|I/O|PB4||COMP2_INP SPI1_MISO:0 TIM22_CH1:4 GPIO
28|I/O|PB5||COMP2_INP I2C1_SMBA:3 LPTIM1_IN1:2 SPI1_MOSI:0 TIM22_CH2:4 GPIO
29|I/O|PB6||COMP2_INP I2C1_SCL:1 LPTIM1_ETR:2 TIM21_CH1:5 USART2_TX:0 GPIO
30|I/O|PB7||COMP2_INP I2C1_SDA:1 LPTIM1_IN2:2 SYS_PVD_IN USART2_RX:0 GPIO
31|Boot|BOOT0||
32|Power|VSS||

[Params]
# Что можно настроить на выводе. Значения РАЗНЫЕ по семействам
# (у H7 скорость имеет VERY_HIGH, у F0 — нет), поэтому они данными.
# имя|подпись|значение по умолчанию
GPIO_Mode|GPIO mode|
GPIO_PuPd|GPIO Pull-up/Pull-down|GPIO_NOPULL
GPIO_Speed|Maximum output speed|GPIO_SPEED_FREQ_LOW
PinState|GPIO output level|GPIO_PIN_RESET

[ParamValues]
# параметр|значение|подпись (подписи из базы, в них бывают пробелы)
GPIO_Mode|GPIO_MODE_INPUT|Input mode
GPIO_Mode|GPIO_MODE_OUTPUT_PP|Output Push Pull
GPIO_Mode|GPIO_MODE_OUTPUT_OD|Output Open Drain
GPIO_Mode|GPIO_MODE_AF_PP|Alternate Function Push Pull
GPIO_Mode|GPIO_MODE_AF_OD|Alternate Function Open Drain
GPIO_Mode|GPIO_MODE_ANALOG|Analog mode
GPIO_Mode|GPIO_MODE_IT_RISING|External Interrupt Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_IT_FALLING|External Interrupt Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_IT_RISING_FALLING|External Interrupt Mode with Rising/Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING|External Event Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_FALLING|External Event Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING_FALLING|External Event Mode with Rising/Falling edge trigger detection
GPIO_PuPd|GPIO_NOPULL|No pull-up and no pull-down
GPIO_PuPd|GPIO_PULLUP|Pull-up
GPIO_PuPd|GPIO_PULLDOWN|Pull-down
GPIO_Speed|GPIO_SPEED_FREQ_LOW|Low
GPIO_Speed|GPIO_SPEED_FREQ_MEDIUM|Medium
GPIO_Speed|GPIO_SPEED_FREQ_HIGH|High
GPIO_Speed|GPIO_SPEED_FREQ_VERY_HIGH|Very High
PinState|GPIO_PIN_RESET|Low
PinState|GPIO_PIN_SET|High
