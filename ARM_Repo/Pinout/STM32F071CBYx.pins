# STM32F071CBYx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F071CBYx
Rpn=STM32F071CB
CmsisDevice=STM32F071xB
Family=STM32F0
Line=STM32F0x1
ClockTree=STM32F0
Package=WLCSP49
Core=Arm Cortex-M0
FrequencyMHz=48
Ram=16384
Flash=131072
IoCount=37
AfScheme=Numbered

[Pins]
