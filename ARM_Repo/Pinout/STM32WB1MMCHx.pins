# STM32WB1MMCHx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WB1MMCHx
Rpn=STM32WB1M
CmsisDevice=
Family=STM32WB
Line=STM32WBxM Modules
ClockTree=STM32WB1
Package=LGA77
Core=Arm Cortex-M4
FrequencyMHz=0
Ram=49152
Flash=327680
IoCount=26
AfScheme=Numbered

