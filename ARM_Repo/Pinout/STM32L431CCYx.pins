# STM32L431CCYx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L431CCYx
Rpn=STM32L431CC
CmsisDevice=STM32L431xx
Family=STM32L4
Line=STM32L4x1
ClockTree=STM32L43
Package=WLCSP49
Core=Arm Cortex-M4
FrequencyMHz=80
Ram=65536
Flash=262144
IoCount=39
AfScheme=Numbered

[Pins]
