# STM32L412C8Ux — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L412C8Ux
Rpn=STM32L412C8
CmsisDevice=STM32L412xx
Family=STM32L4
Line=STM32L4x2
ClockTree=STM32L4x2
Package=UFQFPN48
Core=Arm Cortex-M4
FrequencyMHz=80
Ram=40960
Flash=65536
IoCount=38
AfScheme=Numbered

