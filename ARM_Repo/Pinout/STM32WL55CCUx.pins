# STM32WL55CCUx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WL55CCUx
Rpn=STM32WL55CC
CmsisDevice=
Family=STM32WL
Line=STM32WL5x
ClockTree=STM32WL
Package=UFQFPN48
Core=Arm Cortex-M4
FrequencyMHz=48
Ram=65536
Flash=262144
IoCount=29
AfScheme=Numbered

[Pins]
