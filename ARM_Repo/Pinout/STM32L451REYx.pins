# STM32L451REYx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L451REYx
Rpn=STM32L451RE
CmsisDevice=STM32L451xx
Family=STM32L4
Line=STM32L4x1
ClockTree=STM32L46
Package=WLCSP64
Core=Arm Cortex-M4
FrequencyMHz=80
Ram=163840
Flash=524288
IoCount=52
AfScheme=Numbered

