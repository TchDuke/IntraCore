# STM32F412CEUx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F412CEUx
Rpn=STM32F412CE
CmsisDevice=STM32F412Cx
Family=STM32F4
Line=STM32F412
ClockTree=STM32F412
Package=UFQFPN48
Core=Arm Cortex-M4
FrequencyMHz=100
Ram=262144
Flash=524288
IoCount=36
AfScheme=Numbered

[Pins]
