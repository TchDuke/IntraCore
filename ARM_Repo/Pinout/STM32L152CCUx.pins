# STM32L152CCUx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L152CCUx
Rpn=STM32L152CC
CmsisDevice=STM32L152xC
Family=STM32L1
Line=STM32L151/152
ClockTree=STM32L1
Package=UFQFPN48
Core=Arm Cortex-M3
FrequencyMHz=32
Ram=32768
Flash=262144
IoCount=37
AfScheme=Numbered

