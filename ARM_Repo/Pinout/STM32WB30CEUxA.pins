# STM32WB30CEUxA — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WB30CEUxA
Rpn=STM32WB30CE
CmsisDevice=
Family=STM32WB
Line=STM32WBx0 Value Line
ClockTree=STM32W
Package=UFQFPN48
Core=Arm Cortex-M4
FrequencyMHz=0
Ram=98304
Flash=524288
IoCount=30
AfScheme=Numbered

