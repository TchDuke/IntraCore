# STM32F732RETx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F732RETx
Rpn=STM32F732RE
CmsisDevice=STM32F732xx
Family=STM32F7
Line=STM32F7x2
ClockTree=STM32F722
Package=LQFP64
Core=Arm Cortex-M7
FrequencyMHz=216
Ram=262144
Flash=524288
IoCount=50
AfScheme=Numbered

