# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WBA25CEUx
Rpn=STM32WBA25C
CmsisDevice=
Family=STM32WBA
Line=STM32WBAx5
ClockTree=STM32WBA2
Package=UFQFPN48_SMPS_USB
Core=Arm Cortex-M33
FrequencyMHz=0
Ram=98304
Flash=524288
IoCount=26
AfScheme=Numbered

