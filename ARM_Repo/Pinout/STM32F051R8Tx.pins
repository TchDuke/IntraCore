# STM32F051R8Tx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F051R8Tx
Rpn=STM32F051R8
CmsisDevice=STM32F051x8
Family=STM32F0
Line=STM32F0x1
ClockTree=STM32F0
Package=LQFP64
Core=Arm Cortex-M0
FrequencyMHz=48
Ram=8192
Flash=65536
IoCount=55
AfScheme=Numbered

[Pins]
