# STM32L011F4Ux — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L011F4Ux
Rpn=STM32L011F4
CmsisDevice=STM32L011xx
Family=STM32L0
Line=STM32L0x1
ClockTree=STM32L0
Package=UFQFPN20
Core=Arm Cortex-M0+
FrequencyMHz=32
Ram=2048
Flash=16384
IoCount=16
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
1|I/O|PC14-OSC32_IN||RCC_OSC32_IN GPIO
2|I/O|PC15-OSC32_OUT||RCC_OSC32_OUT GPIO
3|Reset|NRST||
4|Power|VDDA||
5|I/O|PA0-CK_IN||ADC_IN0 COMP1_INM COMP1_OUT:7 LPTIM1_IN1:1 LPUART1_RX:6 RCC_CK_IN RTC_TAMP2 SYS_WKUP1 TIM2_CH1:2 TIM2_ETR:5 USART2_CTS:4 USART2_RX:0 GPIO
6|I/O|PA1||ADC_IN1 COMP1_INP I2C1_SMBA:3 LPTIM1_IN2:1 LPUART1_TX:6 TIM21_ETR:5 TIM2_CH2:2 USART2_DE:4 USART2_RTS:4 GPIO
7|I/O|PA4||ADC_IN4 COMP1_INM COMP2_INM COMP2_OUT:7 I2C1_SCL:3 LPTIM1_ETR:2 LPTIM1_IN1:1 LPUART1_TX:6 SPI1_NSS:0 TIM2_ETR:5 USART2_CK:4 GPIO
8|I/O|PA5||ADC_IN5 COMP1_INM COMP2_INM LPTIM1_IN2:1 SPI1_SCK:0 TIM2_CH1:5 TIM2_ETR:2 GPIO
9|I/O|PA6||ADC_IN6 COMP1_OUT:7 LPTIM1_ETR:1 LPUART1_CTS:4 SPI1_MISO:0 GPIO
10|I/O|PA7||ADC_IN7 COMP2_INP COMP2_OUT:7 LPTIM1_OUT:1 SPI1_MOSI:0 TIM21_ETR:5 USART2_CTS:4 GPIO
11|I/O|PB1||ADC_IN9 LPTIM1_IN1:2 LPUART1_DE:4 LPUART1_RTS:4 SPI1_MOSI:1 SYS_VREF_OUT_PB1 TIM2_CH4:5 USART2_CK:0 GPIO
12|Power|VSS||
13|Power|VDD||
14|I/O|PA9||COMP1_OUT:7 I2C1_SCL:1 LPTIM1_OUT:2 RCC_MCO:0 TIM21_CH2:5 USART2_TX:4 GPIO
15|I/O|PA10||COMP1_OUT:7 I2C1_SDA:1 RTC_REFIN:2 TIM21_CH1:0 TIM2_CH3:5 USART2_RX:4 GPIO
16|I/O|PA13||COMP1_OUT:7 I2C1_SDA:3 LPTIM1_ETR:1 LPUART1_RX:6 SPI1_SCK:5 SYS_SWDIO:0 GPIO
17|I/O|PA14||COMP2_OUT:7 I2C1_SMBA:3 LPTIM1_OUT:1 LPUART1_TX:6 SPI1_MISO:5 SYS_SWCLK:0 USART2_TX:4 GPIO
18|I/O|PB6||COMP2_INP I2C1_SCL:1 LPTIM1_ETR:2 LPUART1_TX:6 TIM2_CH3:5 USART2_TX:0 GPIO
19|I/O|PB7||COMP2_INP I2C1_SDA:1 LPTIM1_IN2:2 LPUART1_RX:6 SYS_PVD_IN TIM2_CH4:5 USART2_RX:0 GPIO
20|I/O|PB9-BOOT0||GPIO

[Params]
# Что можно настроить на выводе. Значения РАЗНЫЕ по семействам
# (у H7 скорость имеет VERY_HIGH, у F0 — нет), поэтому они данными.
# имя|подпись|значение по умолчанию
GPIO_Mode|GPIO mode|
GPIO_PuPd|GPIO Pull-up/Pull-down|GPIO_NOPULL
GPIO_Speed|Maximum output speed|GPIO_SPEED_FREQ_LOW
PinState|GPIO output level|GPIO_PIN_RESET

[ParamValues]
# параметр|значение|подпись (подписи из базы, в них бывают пробелы)
GPIO_Mode|GPIO_MODE_INPUT|Input mode
GPIO_Mode|GPIO_MODE_OUTPUT_PP|Output Push Pull
GPIO_Mode|GPIO_MODE_OUTPUT_OD|Output Open Drain
GPIO_Mode|GPIO_MODE_AF_PP|Alternate Function Push Pull
GPIO_Mode|GPIO_MODE_AF_OD|Alternate Function Open Drain
GPIO_Mode|GPIO_MODE_ANALOG|Analog mode
GPIO_Mode|GPIO_MODE_IT_RISING|External Interrupt Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_IT_FALLING|External Interrupt Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_IT_RISING_FALLING|External Interrupt Mode with Rising/Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING|External Event Mode with Rising edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_FALLING|External Event Mode with Falling edge trigger detection
GPIO_Mode|GPIO_MODE_EVT_RISING_FALLING|External Event Mode with Rising/Falling edge trigger detection
GPIO_PuPd|GPIO_NOPULL|No pull-up and no pull-down
GPIO_PuPd|GPIO_PULLUP|Pull-up
GPIO_PuPd|GPIO_PULLDOWN|Pull-down
GPIO_Speed|GPIO_SPEED_FREQ_LOW|Low
GPIO_Speed|GPIO_SPEED_FREQ_MEDIUM|Medium
GPIO_Speed|GPIO_SPEED_FREQ_HIGH|High
GPIO_Speed|GPIO_SPEED_FREQ_VERY_HIGH|Very High
PinState|GPIO_PIN_RESET|Low
PinState|GPIO_PIN_SET|High
