# STM32F410RBIx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32F410RBIx
Rpn=STM32F410RB
CmsisDevice=STM32F410Rx
Family=STM32F4
Line=STM32F410
ClockTree=STM32F410
Package=UFBGA64
Core=Arm Cortex-M4
FrequencyMHz=100
Ram=32768
Flash=131072
IoCount=50
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
