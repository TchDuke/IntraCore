# STM32WBA25HEFx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32WBA25HEFx
Rpn=STM32WBA25H
CmsisDevice=
Family=STM32WBA
Line=STM32WBAx5
ClockTree=STM32WBA2
Package=WLCSP37_SMPS_USB
Core=Arm Cortex-M33
FrequencyMHz=0
Ram=98304
Flash=524288
IoCount=15
AfScheme=Numbered

[Pins]
# позиция|тип|имя|вариант|сигналы через пробел, каждый — имя[:номер AF]
