# STM32L433CBTx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L433CBTx
Rpn=STM32L433CB
CmsisDevice=STM32L433xx
Family=STM32L4
Line=STM32L4x3
ClockTree=STM32L43
Package=LQFP48
Core=Arm Cortex-M4
FrequencyMHz=80
Ram=65536
Flash=131072
IoCount=38
AfScheme=Numbered

