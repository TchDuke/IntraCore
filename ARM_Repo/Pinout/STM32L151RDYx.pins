# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L151RDYx
Rpn=STM32L151RD
CmsisDevice=STM32L151xD
Family=STM32L1
Line=STM32L151/152
ClockTree=STM32L1
Package=WLCSP64
Core=Arm Cortex-M3
FrequencyMHz=32
Ram=49152
Flash=393216
IoCount=51
AfScheme=Numbered

