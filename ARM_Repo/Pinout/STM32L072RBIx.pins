# STM32L072RBIx — распиновка детали.
# Сгенерировано pinout_import из базы CubeMX. НЕ ПРАВИТЬ РУКАМИ:
# файл перезаписывается импортом. Формат — src/Docs/Description/PinoutFormat.md.

[Part]
RefName=STM32L072RBIx
Rpn=STM32L072RB
CmsisDevice=STM32L072xx
Family=STM32L0
Line=STM32L0x2
ClockTree=STM32L0
Package=UFBGA64
Core=Arm Cortex-M0+
FrequencyMHz=32
Ram=20480
Flash=131072
IoCount=50
AfScheme=Numbered

